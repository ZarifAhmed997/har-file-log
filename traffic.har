:\"クロードにプロンプトを入力してください\"},\"es-419\":{\"greeting\":\"¡Aquí estás!\",\"placeholder\":\"¿Cómo puedo ayudarle hoy?\",\"aria-label\":\"Escriba su mensaje para Claude\"},\"es-ES\":{\"greeting\":\"¡Ya estás aquí!\",\"placeholder\":\"¿Cómo puedo ayudarle hoy?\",\"aria-label\":\"Escriba su consulta para Claude\"},\"it-IT\":{\"greeting\":\"Eccoti!\",\"placeholder\":\"Come posso aiutarti oggi?\",\"aria-label\":\"Scrivi il tuo prompt per Claude\"},\"hi-IN\":{\"greeting\":\"नमस्ते!\",\"placeholder\":\"आज मैं आपकी कैसे मदद कर सकता/सकती हूं?\",\"aria-label\":\"Claude को अपना प्रॉम्प्ट लिखें\"},\"pt-BR\":{\"greeting\":\"Que bom ter você aqui!\",\"placeholder\":\"Como posso ajudar você hoje?\",\"aria-label\":\"Escreva as instruções para o Claude\"},\"id-ID\":{\"greeting\":\"Halo, kamu!\",\"placeholder\":\"Apa yang bisa saya bantu hari ini?\",\"aria-label\":\"Tulis prompt Anda ke Claude\"}}</script><script type=\"application/ld+json\">{\n        \"@context\": \"https://schema.org\",\n        \"@graph\": [\n          {\n            \"@type\": \"WebSite\",\n            \"name\": \"Claude\",\n            \"alternateName\": [\"Claude.ai\", \"Claude by Anthropic\"],\n            \"url\": \"https://claude.com\"\n          },\n          {\n            \"@type\": \"Organization\",\n            \"name\": \"Anthropic\",\n            \"url\": \"https://www.anthropic.com\",\n            \"logo\": \"https://claude.ai/images/claude_ogimage.png\",\n            \"sameAs\": [\n              \"https://x.com/AnthropicAI\",\n              \"https://www.linkedin.com/company/anthropic\",\n              \"https://www.youtube.com/@anthropic-ai\"\n            ]\n          }\n        ]\n      }</script><style id=\"static-composer-style\">#static-composer[hidden]{display:none}#static-composer{position:absolute;z-index:10;isolation:isolate;pointer-events:none;left:0;right:0}#static-composer[data-composer-arm=marlin]{top:3rem;bottom:0}#static-composer[data-composer-arm=marlin]::before{content:\"\";position:fixe