,\"show_on_mobile_web\":null},\"bypass_global_rules\":false,\"bypass_all_rules\":false}},{\"id\":\"476650db-0778-4b29-9d00-8fc9d7cda3b4\",\"key\":\"morning-brief-try-row\",\"content\":null,\"placement_key\":\"sidebar-row\",\"template_key\":null,\"enabled\":true,\"variant_key\":null,\"exp_id\":\"\",\"tier\":\"ambient\",\"config\":{\"platform\":{\"allowed_paths\":[\"/*\"],\"show_on_mobile_web\":null},\"bypass_global_rules\":false,\"bypass_all_rules\":false}},{\"id\":\"ec1e2d12-8a5b-448e-b53a-57939f3d79c1\",\"key\":\"coachmark-epitaxy-preview-browser\",\"content\":{\"side\":\"bottom\",\"align\":\"center\",\"title\":\"Claude now has a browser\",\"anchorId\":\"epitaxy-preview-browser\",\"bodyText\":\"Claude can browse, click, and screenshot to get things done for you, on any site or your own app.\",\"ariaLabel\":\"In app browser\",\"badgeText\":\"New\",\"legacyNuxId\":\"epitaxy_preview_in_app_browser_nux\",\"template_key\":\"coachmark-v1\"},\"placement_key\":\"coachmark\",\"template_key\":\"coachmark-v1\",\"enabled\":true,\"variant_key\":\"default\",\"exp_id\":\"\",\"tier\":\"3\",\"config\":{\"platform\":{\"allowed_paths\":[\"/code/*\",\"/epitaxy/*\"],\"show_on_mobile_web\":null},\"bypass_global_rules\":false,\"bypass_all_rules\":false}},{\"id\":\"d63b4116-1d55-412f-bfac-8d83c9c7b533\",\"key\":\"coachmark-cowork-browser\",\"content\":{\"side\":\"bottom\",\"align\":\"center\",\"title\":\"Cowork now has a built-in browser\",\"anchorId\":\"cowork-browser\",\"bodyText\":\"Claude can open websites, read pages, and fill forms right here, next to your task.\",\"ariaLabel\":\"In app browser\",\"badgeText\":\"New\",\"template_key\":\"coachmark-v1\"},\"placement_key\":\"coachmark\",\"template_key\":\"coachmark-v1\",\"enabled\":true,\"variant_key\":\"default\",\"exp_id\":\"\",\"tier\":\"3\",\"config\":{\"platform\":{\"allowed_paths\":[\"/cowork/*\"],\"show_on_mobile_web\":null},\"bypass_global_rules\":true,\"bypass_all_rules\":false}},{\"id\":\"0abef35d-2bbc-488b-ae9e-0aff7b866497\