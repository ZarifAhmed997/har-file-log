     Object.prototype.hasOwnProperty.call(\n              BING_ALLOWED_VENDOR_EVENTS,\n              entry.vendor_event,\n            )\n              ? entry.vendor_event\n              : undefined;\n          if (uetEventName === undefined) {\n            logDebug(\"bing_uet: no known vendor event on the entry, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n          var pixelIds = entry.pixel_ids;\n          if (!pixelIds || pixelIds.length === 0) {\n            logDebug(\"bing_uet: dormant (no pixel ids on the instruction)\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_dormant\");\n            return;\n          }\n          for (var i = 0; i < pixelIds.length; i++) {\n            var tagId = pixelIds[i];\n            if (!BING_UET_ID_PATTERN.test(tagId)) {\n              logDebug(\"bing_uet: rejecting malformed tag id\");\n              postAdapterCondition(\"adapter_bad_pixel_id\");\n              continue;\n            }\n            ensureBingTag(tagId);\n            bingUetInstances[tagId].push(uetEventName);\n            postPixelFireMetric(envelope.event_name, entry.destination, tagId);\n          }\n        }\n\n        // LinkedIn Insight Tag adapter stub: no envelope event maps to\n        // it and no tag id or loader snippet exists yet, so every\n        // instruction drops as unmapped and no vendor code can load.\n        // The working adapter lands together with LinkedIn's tag id,\n        // snippet, and privacy review.\n        var LINKEDIN_ALLOWED_VENDOR_EVENTS = {};\n        function runLinkedinInsightAdapter(envelope, entry) {\n          var linkedinEventName =\n            entry.vendor_event !== undefined &&\n            Object.prototype.hasOwnProperty.call(\n              LINKEDIN_ALLOWED_VENDOR_EVENTS,\n              entry.vendor_event,\n            )\n              ? entry.vendor_event\n              : undefined;\n          if (linkedinEventName === undefined) {\n            logDebug(\"linkedin_insight: no event mapping, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n        }\n\n        // HubSpot tracking-code command names by envelope event name.\n        var HUBSPOT_ALLOWED_VENDOR_EVENTS = {\n          trackPageView: true,\n        };\n        // The portal id is composed into the loader URL path; exact\n        // numeric guard before composing.\n        var HUBSPOT_PORTAL_ID_PATTERN = /^[0-9]{1,16}$/;\n        var loadedHubspotPortalIds = Object.create(null);\n        function ensureHubspotLoader(portalId) {\n          if (loadedHubspotPortalIds[portalId]) {\n            return;\n          }\n          loadedHubspotPortalIds[portalId] = true;\n          var scriptTag = document.createElement(\"script\");\n          scriptTag.async = true;\n          scriptTag.defer = true;\n          // HubSpot's loader looks itself up by this id; only the\n          // first portal's tag can carry it (ids are unique per\n          // document).\n          if (!document.getElementById(\"hs-script-loader\")) {\n            scriptTag.id = \"hs-script-loader\";\n          }\n          scriptTag.src = \"https://js.hs-scripts.com/\" + portalId + \".js\";\n          var firstScript = document.getElementsByTagName(\"script\")[0];\n          if (firstScript && firstScript.parentNode) {\n            firstScript.parentNode.insertBefore(scriptTag, firstScript);\n          } else {\n            (document.head || document.documentElement).appendChild(scriptTag);\n          }\n        }\n        // HubSpot documents that trackPageView \"is automatically called\n        // when the tracking code loads\", so no trackPageView should be\n        // pushed to _hsq \"before the page loads\"\n        // (https://developers.hubspot.com/docs/api-reference/latest/account/settings/tracking-code/track-page-view);\n        // the recorded path is this frame's own URL unless a setPath is\n        // pushed first. The first envelope-driven push below therefore\n        // lands in exactly that window, so at go-live the first page\n        // view double-counts against the loader's own unless the flip\n        // decides a mitigation: suppress the first push per portal, or\n        // push setPath with the parent's path ahead of it. That choice\n        // (and whether the loader's page view is wanted at all) is a\n        // HubSpot flip-checklist decision, made against staging\n        // traffic; this adapter deliberately does not pre-empt it.\n        function runHubspotTrackingAdapter(envelope, entry) {\n          var hubspotCommand =\n            entry.vendor_event !== undefined &&\n            Object.prototype.hasOwnProperty.call(\n              HUBSPOT_ALLOWED_VENDOR_EVENTS,\n              entry.vendor_event,\n            )\n              ? entry.vendor_event\n              : undefined;\n          if (hubspotCommand === undefined) {\n            logDebug(\"hubspot_tracking: no known vendor event on the entry, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n          var pixelIds = entry.pixel_ids;\n          if (!pixelIds || pixelIds.length === 0) {\n            logDebug(\n              \"hubspot_tracking: dormant (no pixel ids on the instruction)\",\n              { event: envelope.event_name },\n            );\n            postAdapterCondition(\"adapter_dormant\");\n            return;\n          }\n          var validPortalIds = [];\n          for (var i = 0; i < pixelIds.length; i++) {\n            var portalId = pixelIds[i];\n            if (!HUBSPOT_PORTAL_ID_PATTERN.test(portalId)) {\n              logDebug(\"hubspot_tracking: rejecting malformed portal id\");\n              postAdapterCondition(\"adapter_bad_pixel_id\");\n              continue;\n            }\n            validPortalIds.push(portalId);\n            ensureHubspotLoader(portalId);\n          }\n          if (validPortalIds.length === 0) {\n            return;\n          }\n          window._hsq = window._hsq || [];\n          // ONE push per envelope: _hsq is a single global queue every\n          // loaded portal script consumes, so a per-id push loop would\n          // multiply fires.\n          window._hsq.push([hubspotCommand]);\n          // One fire record per portal the push reaches (all of them -\n          // the single queue fans out vendor-side).\n          for (var j = 0; j < validPortalIds.length; j++) {\n            postPixelFireMetric(\n              envelope.event_name,\n              entry.destination,\n              validPortalIds[j],\n            );\n          }\n        }\n\n        // Frame-side copy of ATM_VENDOR_PIXEL_IDS (the reviewed config,\n        // packages/antalytics-react/src/atmConfig.ts): the hard bound\n        // on which ids any adapter may fire, held in the page itself so\n        // a script on an allowed embedder page cannot widen it by\n        // message. CI pins the line below byte-for-byte to the config\n        // (atmPixelIdAllowlistSync.test.ts prints the expected line on\n        // drift), so an id goes live here and in the config in one\n        // reviewed edit.\n        var ATM_PIXEL_ID_ALLOWLIST = {\"meta_pixel\":[],\"google_ads\":[],\"google_floodlight\":[],\"google_floodlight_sales\":[\"DC-15684265\"],\"reddit_pixel\":[],\"tiktok_pixel\":[],\"bing_uet\":[],\"linkedin_insight\":[],\"hubspot_tracking\":[]};\n        // Entry-level gate, not whole-envelope reject: an off-list id\n        // can come from a legitimately newer parent (deploy skew after\n        // a go-live edit while this cached page catches up), so only\n        // the offending entry is dropped - fail-closed and observable -\n        // and the envelope's other destinations still fire.\n        function pixelIdsAllowed(entry) {\n          var ids = entry.pixel_ids;\n          if (ids === undefined) {\n            return true;\n          }\n          var allowed = Object.prototype.hasOwnProperty.call(\n            ATM_PIXEL_ID_ALLOWLIST,\n            entry.destination,\n          )\n            ? ATM_PIXEL_ID_ALLOWLIST[entry.destination]\n            : [];\n          for (var i = 0; i < ids.length; i++) {\n            if (allowed.indexOf(ids[i]) === -1) {\n              return false;\n            }\n          }\n          return true;\n        }\n\n        // Adapter registry + executor. Own-property lookup only: a\n        // destination string is validated for shape, not content, so\n        // prototype names (\"constructor\", \"__proto__\") must not\n        // resolve to anything callable. Unknown destinations are\n        // inert. One adapter throwing must not stop the others.\n        var VENDOR_ADAPTERS = {\n          meta_pixel: runMetaPixelAdapter,\n          google_ads: runGoogleAdsAdapter,\n          google_floodlight: runGoogleFloodlightAdapter,\n          google_floodlight_sales: runGoogleFloodlightAdapter,\n          reddit_pixel: runRedditPixelAdapter,\n          tiktok_pixel: runTiktokPixelAdapter,\n          bing_uet: runBingUetAdapter,\n          linkedin_insight: runLinkedinInsightAdapter,\n          hubspot_tracking: runHubspotTrackingAdapter,\n        };\n        function executeInstruction(envelope) {\n          for (var i = 0; i < envelope.destinations.length; i++) {\n            var entry = envelope.destinations[i];\n            if (!pixelIdsAllowed(entry)) {\n              logDebug(\"Dropping entry whose pixel ids are not in the page allowlist\", {\n                destination: entry.destination,\n              });\n              postAdapterCondition(\"adapter_unlisted_pixel_id\");\n              continue;\n            }\n            // Per-pixel killswitch, consumer