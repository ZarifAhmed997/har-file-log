            "mimeType": "text/event-stream",
            "text": "event: server_list\r\ndata: {\"servers\": [{\"uuid\": \"4fa86480-4c63-429a-861d-485ad06a049a\", \"name\": \"Gmail\", \"url\": \"https://gmailmcp.googleapis.com/mcp/v1\", \"cai_flags\": [], \"id_jag_config\": null}, {\"uuid\": \"6f3f2bf3-bda5-4600-ab89-23de247fbcf8\", \"name\": \"Google Calendar\", \"url\": \"https://calendarmcp.googleapis.com/mcp/v1\", \"cai_flags\": [], \"id_jag_config\": null}, {\"uuid\": \"6bb3887c-31f3-49ef-b438-961d0e737ae7\", \"name\": \"Google Drive\", \"url\": \"https://drivemcp.googleapis.com/mcp/v1\", \"cai_flags\": [], \"id_jag_config\": null}, {\"uuid\": \"6f616b42-0ed8-571e-823f-ee4aca6b7ce9\", \"name\": \"visualize\", \"url\": \"https://sandbox.claudemcpcontent.com/imagine_mcp\", \"cai_flags\": [\"auto_accept_permissions\", \"hide_tool_chrome_in_chat\", \"hide_from_connectors_list\"], \"id_jag_config\": null}], \"completion_filter\": {\"v\": 1, \"applied\": true, \"as_of\": 1788354924, \"roster_header\": \"v1; org=8a499207-0c8b-48c8-92d1-ecb2e37f516a; acct=95cdd3ba-7cd6-4367-b3bf-0d00847b6633; as_of=1788354924; eligible=4fa86480-4c63-429a-861d-485ad06a049a,6bb3887c-31f3-49ef-b438-961d0e737ae7,6f3f2bf3-bda5-4600-ab89-23de247fbcf8\"}}\r\n\r\nevent: server_base\r\ndata: {\"uuid\": \"6f616b42-0ed8-571e-823f-ee4aca6b7ce9\", \"name\": \"visualize\", \"url\": \"https://sandbox.claudemcpcontent.com/imagine_mcp\", \"canonicalUrl\": \"https://sandbox.claudemcpcontent.com/imagine_mcp\", \"custom_oauth_client_id\": null, \"id_jag_config\": null, \"connected\": true, \"usedAuthentication\": true, \"authStatus\": \"authenticated\", \"authProvenance\": \"browser_oauth\", \"authErrorType\": null, \"authErrorSubtype\": null, \"interactiveAvailable\": null, \"authRemediation\": null, \"managedFallbackRemediation\": null, \"connectionError\": null, \"iconUrl\": \"https://www.google.com/s2/favicons?domain=claudemcpcontent.com&sz=64\", \"allow_indexing\": false, \"allowed_link_domains\": null, \"cai_flags\": [\"auto_accept_permissions\", \"hide_tool_chrome_in_chat\", \"hide_from_connectors_list\"], \"hasDesignImport\": false, \"isDirectoryServer\": null, \"createdAt\": null, \"instructions\": \"\", \"protocolVersion\": \"2025-11-25\", \"capabilities\": {\"resources\": {}, \"tools\": {}}, \"serverInfo\": {\"name\": \"visualize\", \"version\": \"1.0.0\"}}\r\n\r\nevent: prompts\r\ndata: {\"server_uuid\": \"6f616b42-0ed8-571e-823f-ee4aca6b7ce9\", \"prompts\": []}\r\n\r\nevent: tools\r\ndata: {\"server_uuid\":\"6f616b42-0ed8-571e-823f-ee4aca6b7ce9\",\"tools\":[{\"name\":\"read_me\",\"description\":\"Returns required context for show_widget (CSS variables, colors, typography, layout rules, examples). Call before your first show_widget call. Call again later if you need a different module. Do NOT mention or narrate this call to the user — it is an internal setup step. Call it silently and proceed directly to the visualization in your response.\",\"display_description\":\"Returns required context for show_widget (CSS variables, colors, typography, layout rules, examples).\",\"annotations\":{\"title\":null,\"readOnlyHint\":true,\"destructiveHint\":null,\"idempotentHint\":null,\"openWorldHint\":null},\"enabled_key\":\"6f616b42-0ed8-571e-823f-ee4aca6b7ce9:read_me\",\"always_approved_key\":\"6f616b42-0ed8-571e-823f-ee4aca6b7ce9:read_me-c952e3420a5eaaa9faca4e842030f951\",\"displayName\":\"Read me\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"modules\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"diagram\",\"mockup\",\"interactive\",\"data_viz\",\"art\",\"chart\",\"elicitation\"]},\"description\":\"Which module(s) to load. Pick all that fit.\"},\"platform\":{\"type\":\"string\",\"enum\":[\"mobile\",\"desktop\",\"unknown\"],\"description\":\"The client platform the widget will render on. Pass 'mobile' when your system prompt indicates a mobile client (narrow ~380px viewport) so SVG viewBox and layout guidance are sized accordingly; otherwise pass 'desktop'. Defaults to 'unknown' (desktop sizing).\"}}},\"outputSchema\":null,\"_meta\":{\"claude.ai/hidden_in_chat\":true},\"org_max_permission\":null,\"rbac_max_permission\":null,\"effective_max_permission\":null,\"default_user_permission\":\"allow\"},{\"name\":\"show_widget\",\"description\":\"Show visual content — SVG graphics, diagrams, charts, or interactive HTML widgets — that renders inline alongside your text response. Use for flowcharts, architecture diagrams, dashboards, forms, calculators, data tables, games, illustrations, or any visual content. The code is auto-detected: starts with <svg = SVG mode, otherwise HTML mode. A global sendPrompt(text) function is available — it sends a message to chat as if the user typed it. IMPORTANT: Call read_me before your first show_widget call. Do NOT narrate or mention the read_me call to the user — call it silently, then respond as if you went straight to building the visualization.\",\"display_description\":\"Show visual content — SVG graphics, diagrams, charts, or interactive HTML widgets — that renders inline alongside your…\",\"annotations\":{\"title\":null,\"readOnlyHint\":true,\"destructiveHint\":null,\"idempotentHint\":null,\"openWorldHint\":null},\"enabled_key\":\"6f616b42-0ed8-571e-823f-ee4aca6b7ce9:show_widget\",\"always_approved_key\":\"6f616b42-0ed8-571e-823f-ee4aca6b7ce9:show_widget-5bcfdd87e5f33ea56480bec15dd3a1e4\",\"displayName\":\"Show widget\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"loading_messages\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"maxItems\":4,\"description\":\"1–4 loading messages shown to the user while the visual renders, each roughly 5 words long. Write them in the same language the user is using. Use 1 for simple visuals, more for complex ones. If the topic is serious — illness, disease, pandemics, death, grief, war, conflict, poverty, disaster, trauma, abuse, addiction, medical decisions, politically charged subjects, or anything where the reader might be personally affected — keep these BORING: describe what the code is doing in the dullest generic way, no jargon-as-drama, no evocative terms. Pandemic growth model — NOT ['Simulating patient zero', 'Modeling the curve'] (documentary-narrator voice), YES ['Setting up the model', 'Running the calculation']. Cancer timeline — NOT ['Charting the battle ahead'], YES ['Laying out the stages']. If you have to ask whether it's serious, it is. Otherwise, have fun — reach for alliteration, puns, personification, wordplay, whatever lands in that language. Playful examples — revenue chart: ['Bribing bars to stand taller', 'Asking Q4 where it went']; kanban: ['Herding cards into columns', 'Dragging, dropping, not stopping'].\"},\"title\":{\"type\":\"string\",\"description\":\"Short snake_case identifier for this visual. Must be specific and disambiguating — if the conversation has multiple visuals, this title alone should tell you which one is being referenced (e.g. 'q4_revenue_by_product_line' not 'chart', 'oauth_login_flow' not 'diagram'). Also used as the download filename, so no spaces or special characters.\"},\"widget_code\":{\"type\":\"string\",\"description\":\"SVG or HTML code to render. For SVG: raw SVG code starting with <svg> tag, must use CSS variables for colors. Example: <svg viewBox=\\\"0 0 700 400\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">...</svg>. For HTML: raw HTML content to render, do NOT include DOCTYPE, <html>, <head>, or <body> tags. Use CSS variables for theming. Keep background transparent and avoid top-level padding. Scripts are supported but execute after streaming completes.\"}},\"required\":[\"loading_messages\",\"title\",\"widget_code\"]},\"outputSchema\":null,\"_meta\":{\"ui\":{\"resourceUri\":\"ui://imagine/show-widget.html\"}},\"org_max_permission\":null,\"rbac_max_permission\":null,\"effective_max_permission\":null,\"default_user_permission\":\"allow\"}]}\r\n\r\nevent: resources\r\ndata: {\"server_uuid\": \"6f616b42-0ed8-571e-823f-ee4aca6b7ce9\", \"resources\": [{\"name\": \"visualize widget\", \"title\": null, \"uri\": \"ui://imagine/show-widget.html\", \"description\": \"Renders SVG or HTML content progressively as it streams for the show_widget tool\", \"mimeType\": \"text/html;profile=mcp-app\", \"size\": null, \"icons\": null, \"annotations\": null, \"_meta\": null, \"hidden\": true, \"displayName\": \"Visualize widget\"}]}\r\n\r\nevent: first_pass_complete\r\ndata: {}\r\n\r\nevent: server_base\r\ndata: {\"uuid\": \"4fa86480-4c63-429a-861d-485ad06a049a\", \"name\": \"Gmail\", \"url\": \"https://gmailmcp.googleapis.com/mcp/v1\", \"canonicalUrl\": \"https://gmailmcp.googleapis.com/mcp/v1\", \"custom_oauth_client_id\": null, \"id_jag_config\": null, \"connected\": false, \"usedAuthentication\": false, \"authStatus\": null, \"authProvenance\": null, \"authErrorType\": null, \"authErrorSubtype\": null, \"interactiveAvailable\": null, \"authRemediation\": null, \"managedFallbackRemediation\": null, \"connectionError\": null, \"iconUrl\": \"https://t0.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://mail.google.com&size=64\", \"allow_indexing\": false, \"allowed_link_domains\": null, \"cai_flags\": [], \"hasDesignImport\": false, \"isDirectoryServer\": false, \"createdAt\": \"2026-03-09T09:24:37.275110Z\", \"instructions\": null, \"protocolVersion\": null, \"capabilities\": null, \"serverInfo\": null}\r\n\r\nevent: server_base\r\ndata: {\"uuid\": \"6f3f2bf3-bda5-4600-ab89-23de247fbcf8\", \"name\": \"Google Calendar\", \"url\": \"https://calendarmcp.googleapis.com/mcp/v1\", \"canonicalUrl\": \"https://calendarmcp.googleapis.com/mcp/v1\", \"custom_oauth_client_id\": null, \"id_jag_config\": null, \"connected\": false, \"usedAuthentication\": false, \"authStatus\": null, \"authProvenance\": null, \"authErrorType\": null, \"authErrorSubtype\": null, \"interactiveAvailable\": null, \"authRemediation\": null, \"managedFallbackRemediation\": null, \"connectionError\": null, \"iconUrl\": \"h