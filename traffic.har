          "content": {
            "size": 114901,
            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <!-- Segment snippet from https://segment.com/docs/connections/sources/catalog/libraries/website/javascript/quickstart/ -->\n    <!-- Modified to load from the pinned Segment CDN host and removed unused methods -->\n    <script>\n      !(function () {\n        var i = \"analytics\",\n          analytics = (window[i] = window[i] || []);\n        if (!analytics.initialize)\n          if (analytics.invoked)\n            window.console &&\n              console.error &&\n              console.error(\"Segment snippet included twice.\");\n          else {\n            analytics.invoked = !0;\n            analytics.methods = [\"identify\", \"track\", \"ready\"];\n            analytics.factory = function (e) {\n              return function () {\n                if (window[i].initialized)\n                  return window[i][e].apply(window[i], arguments);\n                var n = Array.prototype.slice.call(arguments);\n                if ([\"track\", \"identify\"].indexOf(e) > -1) {\n                  var c = document.querySelector(\"link[rel='canonical']\");\n                  n.push({\n                    __t: \"bpc\",\n                    c: (c && c.getAttribute(\"href\")) || void 0,\n                    p: location.pathname,\n                    u: location.href,\n                    s: location.search,\n                    t: document.title,\n                    r: document.referrer,\n                  });\n                }\n                n.unshift(e);\n                analytics.push(n);\n                return analytics;\n              };\n            };\n            for (var n = 0; n < analytics.methods.length; n++) {\n              var key = analytics.methods[n];\n              analytics[key] = analytics.factory(key);\n            }\n            analytics.SNIPPET_VERSION = \"5.2.1\";\n          }\n      })();\n    </script>\n    <script>\n      (function () {\n        // Debug logging function\n        function logDebug(message, ...args) {\n          console.debug(\"[IsolatedSegment]\", message, ...args);\n        }\n\n        // Keep sending ready message until we get init response\n        let readyInterval = null;\n\n        // --- pixel telemetry -------------------------------------------\n        // Observability for vendor pixel network requests. Two\n        // independent counters, no correlation:\n        //  - pixel_attempt:  posted at each vendor call site in track()\n        //  - pixel_observed: posted per classified beacon seen by a\n        //                    PerformanceObserver on resource timings\n        // A blocked/failed vendor (ad-blocker, CSP, DNS, SDK didn't\n        // load) shows up as attempt-without-observed in aggregate. The\n        // resource URL is used only for vendor classification here and\n        // is never sent to the parent.\n        //\n        // Cross-origin caveat: pixel endpoints (facebook.com/tr,\n        // doubleclick.net, googleadservices.com) do not send\n        // Timing-Allow-Origin, so responseStatus is zeroed for most\n        // entries; http_status is only populated when the browser\n        // actually exposes it.\n        var pixelFirePixelIds = {}; // vendor → configured pixel/tag ID\n        // One observer per page load: init() and the ATM adapters'\n        // registerPixelFireId hook can each ask for it, in any order.\n        var pixelObserverStarted = false;\n\n        // Patterns match only the conversion beacons, not loader /\n        // aux / config requests (e.g. gtag/destination,\n        // conversion_async.js). gtag typically fans one conversion\n        // out to several of these endpoints; each is reported as its\n        // own pixel_observed — attempt and observed counts are not\n        // expected to be 1:1 per event, only comparable in aggregate.\n        var PIXEL_FIRE_PATTERNS = [\n          { match: \"facebook.com/tr\", vendor: \"facebook\" },\n          { match: \"googleadservices.com/pagead/conversion/\", vendor: \"google_ads\" },\n          { match: \"google.com/pagead/\", vendor: \"google_ads\" },\n          { match: \"googleads.g.doubleclick.net/pagead/\", vendor: \"google_ads\" },\n          { match: \"fls.doubleclick.net/\", vendor: \"floodlight\" },\n          { match: \"ad.doubleclick.net/activity\", vendor: \"floodlight\" },\n          { match: \"ad.doubleclick.net/ddm/activity\", vendor: \"floodlight\" },\n        ];\n\n        function classifyPixelResource(url) {\n          for (var i = 0; i < PIXEL_FIRE_PATTERNS.length; i++) {\n            if (url.indexOf(PIXEL_FIRE_PATTERNS[i].match) !== -1) {\n              return PIXEL_FIRE_PATTERNS[i];\n            }\n          }\n          return null;\n        }\n\n        function sendPixelTelemetry(payload) {\n          if (window.isolatedSegment && window.isolatedSegment.sendMessage) {\n            window.isolatedSegment.sendMessage(payload);\n          }\n        }\n\n        function pixelAttempt(pixel) {\n          if (!pixel) return;\n          sendPixelTelemetry({ type: \"pixel_attempt\", pixel: pixel });\n        }\n\n        function pixelObserved(entry, cls) {\n          var pixel = pixelFirePixelIds[cls.vendor];\n          if (!pixel) return;\n          var payload = {\n            type: \"pixel_observed\",\n            pixel: pixel,\n            duration_ms: Math.round(entry.duration || 0),\n          };\n          var status = entry.responseStatus;\n          if (typeof status === \"number\" && status > 0) {\n            payload.http_status = status;\n          }\n          sendPixelTelemetry(payload);\n        }\n\n        function startPixelFireObserver() {\n          if (pixelObserverStarted) return;\n          if (typeof PerformanceObserver === \"undefined\") return;\n          try {\n            var po = new PerformanceObserver(function (list) {\n              var entries = list.getEntries();\n              for (var i = 0; i < entries.length; i++) {\n                var cls = classifyPixelResource(entries[i].name);\n                if (cls) try { pixelObserved(entries[i], cls); } catch {}\n              }\n            });\n            po.observe({ type: \"resource\", buffered: true });\n            pixelObserverStarted = true;\n          } catch (e) {\n            logDebug(\"pixel telemetry PerformanceObserver unavailable\", {\n              error: String(e),\n            });\n          }\n        }\n        // --- end pixel telemetry ---------------------------------------\n\n        /* The values of this mapping must match the values in the Facebook CAPI destinations in Segment\n           See go/segment -> Destinations -> Facebook Conversions API -> Mappings\n           We have to do this mapping because the Facebook Pixel integration from Segment does not support\n           event renaming on the client side\n        */\n        const FB_EVENT_MAPPING = {\n          \"onboarding.started\": \"Started Onboarding\",\n          \"extended_onboarding.started\": \"Started Onboarding\",\n          \"extended_onboarding.completed\": \"CompleteRegistration\",\n          \"chat.conversation.first_conversation_created\": \"NewConversation\",\n          payment_state_success: \"Purchase\",\n        };\n\n        // Floodlight activity tag resolver: returns the CM360 send_to string\n        // for an event, or null if the event has no Floodlight conversion.\n        // Format: DC-ADVERTISER_ID/activity_group/activity_tag+counting_method\n        function resolveFloodlightSendTo(event, properties) {\n          var props = properties || {};\n          switch (event) {\n            case \"extended_onboarding.completed\":\n              // CM360: Onboarding Completed [production]\n              return \"DC-15684265/check0/onboa000+unique\";\n            case \"payment_state_success\":\n              if (props.product_capability === \"claude_pro\") {\n                // CM360: Purchased Pro [production]\n                return \"DC-15684265/check0/purch00+unique\";\n              }\n              if (props.product_capability === \"claude_max\") {\n                if (props.rate_limit_tier === \"default_claude_max_20x\") {\n                  // CM360: Purchased Max 20x [production]\n                  return \"DC-15684265/check0/purch001+unique\";\n                }\n                // CM360: Purchased Max 5x [production]\n                return \"DC-15684265/check0/purch000+unique\";\n              }\n              return null;\n            default:\n              return null;\n          }\n        }\n\n        // Google Ads conversion resolver: returns the conversion params for\n        // an event, or null. Format: AW-CONVERSION_ID/CONVERSION_LABEL\n        function resolveGoogleAdsConversion(event, properties) {\n          switch (event) {\n            case \"extended_onboarding.completed\":\n              // Google Ads: Sign-up\n              return {\n                send_to: \"AW-16632748715/vj71CLSLlPwbEKu1jvs9\",\n                value: 1.0,\n                currency: \"USD\",\n              };\n            case \"payment_state_success\":\n              // Google Ads: Purchase. transaction_id is omitted when no real\n              // value exists — Google Ads dedupes on it, so passing \"\" would\n              // collapse all such conversions into one.\n              var purchase = {\n                send_to: \"AW-16632748715/H4ugCKmKh_wbEKu1jvs9\",\n                value: 1.0,\n                currency: \"USD\",\n              };\n              if (properties && properties.invoice_created_ts) {\n                purchase.transaction_id = String(\n                  properties.invoice_created_ts,\n                );\n              }\n              return purchase;\n            default:\n              return null;\n          }\n        }\n\n        // Google Ads MCC-account conversion resolver. Parallel to\n        // resolveGoogleAdsConversion above — dual-fires to the MCC\n        // (manager) account while the legacy direct account is still\n        // live, so either side can be removed independently once the\n        // migration settles. Purchase-only for now.\n        function resolveGoogleAdsMccConversion(event, properties) {\n          switch (event) {\n            case \"payment_state_success\":\n              // Google Ads (MCC): Purchase. transaction_id mirrors the\n              // legacy account's dedup key (invoice_created_ts) so both\n              // accounts dedupe identically; may switch to external_id\n              // once that value is available client-side. Omitted when\n              // absent — Google Ads dedupes on it, so an empty string\n              // would collapse all such conversions into one.\n              var purchase = {\n                send_to: \"AW-11477462985/5dbtCKe7qbccEMnf8OAq\",\n                value: 1.0,\n                currency: \"USD\",\n              };\n              if (properties && properties.invoice_created_ts) {\n                purchase.transaction_id = String(\n                  properties.invoice_created_ts,\n                );\n              }\n              return purchase;\n            default:\n              return null;\n          }\n        }\n\n        // Initialize gtag.js directly (no GTM container)\n        function initGtag(measurementId, floodlightId, mccMeasurementId) {\n          if (!measurementId && !floodlightId && !mccMeasurementId) {\n            logDebug(\"No measurement or Floodlight ID provided, skipping gtag\");\n            return;\n          }\n\n          window.dataLayer = window.dataLayer || [];\n          window.gtag = function () {\n            window.dataLayer.push(arguments);\n          };\n\n          // Set default consent to granted since the parent only renders\n          // this iframe when marketing consent is already granted\n          window.gtag(\"consent\", \"default\", {\n            ad_personalization: \"granted\",\n            ad_user_data: \"granted\",\n            ad_storage: \"granted\",\n            analytics_storage: \"granted\",\n            functionality_storage: \"granted\",\n            personalization_storage: \"granted\",\n            security_storage: \"granted\",\n          });\n          window.gtag(\"js\", new Date());\n\n          // Load the gtag.js script using whichever ID is available\n          var primaryId = measurementId || floodlightId || mccMeasurementId;\n          var scriptTag = document.createElement(\"script\");\n          scriptTag.async = true;\n          scriptTag.src =\n            \"https://www.googletagmanager.com/gtag/js?id=\" + primaryId;\n          var firstTag = document.getElementsByTagName(\"script\")[0];\n          firstTag.parentNode.insertBefore(scriptTag, firstTag);\n\n          // Configure measurement ID (Google Ads / GA4)\n          if (measurementId) {\n            window.gtag(\"config\", measurementId, { send_page_view: false });\n          }\n\n          // Configure Floodlight (CM360)\n          if (floodlightId) {\n            window.gtag(\"config\", floodlightId, { send_page_view: false, allow_enhanced_conversions: true });\n          }\n\n          // Configure Google Ads MCC (manager) account — dual-fired\n          // alongside measurementId during the account migration.\n          if (mccMeasurementId) {\n            window.gtag(\"config\", mccMeasurementId, { send_page_view: false });\n          }\n\n          logDebug(\"gtag.js loaded\", { measurementId, floodlightId, mccMeasurementId });\n        }\n\n        // The marketing iframe hosts (a.claude.com, a.anthropic.com)\n        // carry ONLY the ATM bus in the next script block. This legacy\n        // Segment bus accepts a parent-supplied writeKey, cdnHost, and\n        // gtag and Floodlight ids from any base-domain parent, which is\n        // acceptable where the claude.ai SPA is the only possible\n        // parent, but on a marketing zone it would let any script on\n        // the parent page drive vendor beacons from this origin with\n        // ids and a script host of its choosing. The gate is an\n        // ALLOWLIST of the claude.ai-family isolation hosts, so it\n        // fails closed: a future a.* host gets no legacy bus unless\n        // deliberately added here. It sweeps all three of the bus's\n        // legs: the inbound message listener, the iframe_ready announce\n        // loop, and sendMessage below — the one outbound in this frame\n        // that posts with targetOrigin \"*\". Non-a.* serving (dev,\n        // tests, the same-origin preview fallback) is the app's own\n        // origin and keeps the bus, unchanged. The staging host is\n        // matched by its app-name-plus-environment prefix rather than\n        // a full hostname literal: internal domain suffixes must not\n        // appear in the public bundle (the build's tree-shaking canary\n        // enforces this), and the prefix keeps the match as tight as a\n        // full-hostname form.\n        var legacyBusEnabled = (function () {\n          var host = window.location.hostname;\n          if (host.indexOf(\"a.\") !== 0) {\n            return true;\n          }\n          var base = host.substring(2);\n          return (\n            base === \"claude.ai\" ||\n            base === \"preview.claude.ai\" ||\n            base.indexOf(\"claude-ai.staging\") === 0\n          );\n        })();\n\n        // Pinned Segment CDN host; change together with segmentCdnHost in\n        // packages/utils/config.ts (the isolatedSegmentCdnHostPin test enforces agreement)\n        var SEGMENT_CDN_HOST = \"a-cdn.anthropic.com\";\n\n        // Create isolated segment object on window\n        window.isolatedSegment = {\n          initialized: false,\n          writeKey: null,\n          segmentCdnHost: null,\n\n          // Initialize the isolated segment instance\n          init: function (\n            writeKey,\n            segmentCdnHost,\n            gtagMeasurementId,\n            floodlightId,\n            gtagMccMeasurementId,\n          ) {\n            logDebug(\"init called\", {\n              writeKey: writeKey?.substring(0, 10) + \"...\",\n              gtagMeasurementId,\n              gtagMccMeasurementId,\n              floodlightId,\n              alreadyInitialized: this.initialized,\n            });\n\n            if (this.initialized) {\n              logDebug(\"Already initialized, skipping\");\n              return;\n            }\n\n            // Refuse without latching so the parent's next init still succeeds\n            if (segmentCdnHost !== SEGMENT_CDN_HOST) {\n              logDebug(\n                \"Init rejected - cdnHost is not the pinned Segment CDN host\",\n              );\n              this.sendMessage({\n                type: \"segment_initialized\",\n                success: false,\n                error: \"cdn_host_rejected\",\n              });\n              return;\n            }\n\n            this.writeKey = writeKey;\n            this.segmentCdnHost = segmentCdnHost;\n\n            try {\n              logDebug(\"Loading analytics via analytics.js\");\n\n              // The Segment snippet defines no load; this is the loader\n              window.analytics.load = function (key, options) {\n                const script = document.createElement(\"script\");\n                script.type = \"text/javascript\";\n                script.async = true;\n                script.setAttribute(\n                  \"data-global-segment-analytics-key\",\n                  \"analytics\",\n                );\n                script.src =\n                  \"https://\" +\n                  SEGMENT_CDN_HOST +\n                  \"/analytics.js/v1/\" +\n                  key +\n                  \"/analytics.min.js\";\n                const firstScript =\n                  document.getElementsByTagName(\"script\")[0];\n                firstScript.parentNode.insertBefore(script, firstScript);\n                window.analytics._loadOptions = options;\n              };\n\n              // Configure analytics options\n              const loadOptions = {\n                disableClientPersistence: true, // Prevent Segment from setting ajs_anonymous_id cookie\n                integrations: {\n                  All: false,\n                  \"Segment.io\": false,\n                  \"Facebook Pixel\": true,\n                },\n              };\n\n              // Load analytics\n              window.analytics.load(writeKey, loadOptions);\n\n              // Initialize gtag.js if measurement ID or Floodlight ID provided\n              if (gtagMeasurementId || floodlightId || gtagMccMeasurementId) {\n                initGtag(gtagMeasurementId, floodlightId, gtagMccMeasurementId);\n              }\n\n              this.initialized = true;\n\n              // pixel telemetry: record configured pixel IDs for each\n              // vendor, then start watching resource timings. FB emits\n              // the constant \"fb\" rather than the numeric pixel id —\n              // the real id lives in Segment's destination config (not\n              // ours), so the parent cannot ground-truth it.\n              // Both Google Ads accounts (legacy + MCC) fire to the\n              // same googleadservices.com/doubleclick endpoints, so\n              // the resource-timing observer cannot tell their\n              // beacons apart. They share one telemetry bucket; the\n              // representative ID is whichever is configured (legacy\n              // first, falling back to MCC) so this survives either\n              // account's removal.\n              if (gtagMeasurementId || gtagMccMeasurementId) {\n                pixelFirePixelIds.google_ads =\n                  gtagMeasurementId || gtagMccMeasurementId;\n              }\n              if (floodlightId) {\n                pixelFirePixelIds.floodlight = floodlightId;\n              }\n              pixelFirePixelIds.facebook = \"fb\";\n              startPixelFireObserver();\n\n              logDebug(\"Analytics loaded successfully\", {\n                hasAnalytics: !!window.analytics,\n                hasGtag: typeof window.gtag === \"function\",\n              });\n\n              // Clear the ready interval\n              if (readyInterval) {\n                clearInterval(readyInterval);\n                readyInterval = null;\n              }\n\n              // Send confirmation back to parent\n              this.sendMessage({\n                type: \"segment_initialized\",\n                success: true,\n              });\n            } catch (error) {\n              logDebug(\"Failed to initialize analytics\", {\n                error: error.message,\n              });\n              this.sendMessage({\n                type: \"segment_initialized\",\n                success: false,\n                error: error.message,\n              });\n            }\n          },\n\n          track: async function (event, properties, options) {\n            logDebug(\"track called\", {\n              event,\n              properties,\n              initialized: this.initialized,\n              hasAnalytics: !!window.analytics,\n              hasGtag: typeof window.gtag === \"function\",\n            });\n\n            if (!this.initialized) {\n              logDebug(\"Track skipped - not initialized\");\n              return;\n            }\n\n            // Fire gtag conversions first — gtag() is synchronous (just\n            // pushes to dataLayer) and has no dependency on Segment. Doing it\n            // before the FB await means a hung Segment promise can't block it.\n            if (typeof window.gtag === \"function\") {\n              var floodlightSendTo = resolveFloodlightSendTo(\n                event,\n                properties,\n              );\n              if (floodlightSendTo) {\n                try { pixelAttempt(pixelFirePixelIds.floodlight); } catch {}\n                window.gtag(\"event\", \"conversion\", {\n                  send_to: floodlightSendTo,\n                });\n                logDebug(\"Track completed for Floodlight\", {\n                  event,\n                  send_to: floodlightSendTo,\n                });\n              }\n\n              var googleAdsConversion = resolveGoogleAdsConversion(\n                event,\n                properties,\n              );\n              if (googleAdsConversion) {\n                try { pixelAttempt(pixelFirePixelIds.google_ads); } catch {}\n                window.gtag(\"event\", \"conversion\", googleAdsConversion);\n                logDebug(\"Track completed for Google Ads\", {\n                  event,\n                  send_to: googleAdsConversion.send_to,\n                });\n              }\n\n              var googleAdsMccConversion = resolveGoogleAdsMccConversion(\n                event,\n                properties,\n              );\n              if (googleAdsMccConversion) {\n                try { pixelAttempt(pixelFirePixelIds.google_ads); } catch {}\n                window.gtag(\"event\", \"conversion\", googleAdsMccConversion);\n                logDebug(\"Track completed for Google Ads (MCC)\", {\n                  event,\n                  send_to: googleAdsMccConversion.send_to,\n                });\n              }\n            }\n\n            // Get the remapped Facebook event name\n            const fbEventName = FB_EVENT_MAPPING[event] || event;\n\n            if (window.analytics) {\n              try { pixelAttempt(pixelFirePixelIds.facebook); } catch {}\n              try {\n                // Track with Facebook event name for Facebook Pixel only\n                await window.analytics.track(fbEventName, properties || {}, {\n                  ...(options || {}),\n                  integrations: {\n                    All: false,\n                    \"Facebook Pixel\": true,\n                  },\n                });\n                logDebug(\"Track completed for Facebook Pixel\", {\n                  originalEvent: event,\n                  fbEventName,\n                });\n              } catch (e) {\n                logDebug(\"Track failed for Facebook Pixel\", {\n                  originalEvent: event,\n                  error: String(e),\n                });\n              }\n            }\n          },\n\n          identify: async function (userId, traits, options) {\n            logDebug(\"identify called\", {\n              userId,\n              traits,\n              initialized: this.initialized,\n              hasAnalytics: !!window.analytics,\n            });\n\n            if (!this.initialized) {\n              logDebug(\"Identify skipped - not initialized\");\n              return;\n            }\n\n            // Set user_data for Enhanced Conversions (CM360/SA360).\n            // gtag normalizes and SHA-256 hashes the email client-side\n            // before sending — raw email never leaves the browser unhashed.\n            if (typeof window.gtag === \"function\" && traits && traits.email) {\n              window.gtag(\"set\", \"user_data\", { email: traits.email });\n              logDebug(\"gtag user_data set for Enhanced Conversions\");\n            }\n\n            if (!window.analytics) {\n              logDebug(\"Identify skipped for Segment - no analytics\");\n              return;\n            }\n\n            try {\n              await window.analytics.identify(\n                userId,\n                traits || {},\n                options || {},\n              );\n              logDebug(\"Identify completed\", { userId });\n            } catch (e) {\n              logDebug(\"Identify failed for Segment\", {\n                userId,\n                error: String(e),\n              });\n            }\n          },\n\n          // Send messages to parent window\n          sendMessage: function (data) {\n            // No legacy bus means no outbound either: no parent speaks\n            // this protocol on the marketing hosts, and this is the one\n            // post in the frame with targetOrigin \"*\" — the ATM block's\n            // pixel telemetry funnels here, so without this gate every\n            // vendor fire would wildcard-post a dead legacy message.\n            if (!legacyBusEnabled) {\n              return;\n            }\n            // Only log sendMessage for non-ready messages after initialization\n            if (data.type !== \"iframe_ready\") {\n              logDebug(\"sendMessage called\", { data });\n            }\n            if (window.parent && window.parent !== window) {\n              try {\n                window.parent.postMessage(\n                  {\n                    source: \"isolated-segment\",\n                    ...data,\n                  },\n                  \"*\",\n                );\n                if (data.type !== \"iframe_ready\") {\n                  logDebug(\"Message sent to parent\", { type: data.type });\n                }\n              } catch (error) {\n                logDebug(\"Failed to send message to parent\", { error });\n              }\n            }\n          },\n\n          // Pixel-fire telemetry hooks for the AtmConsumer block below.\n          // The vendor id map and the PerformanceObserver above are\n          // closure-local to this script, and init() (the only caller\n          // that starts them) never runs when the legacy bus is off, so\n          // the ATM vendor adapters register their ids and count\n          // attempts through these two entry points instead. Any script\n          // in this frame can call them; that stays within this\n          // telemetry's documented trust envelope (counts only, and the\n          // parent allowlists the pixel value it relays). The Meta and\n          // gtag (Google Ads, Floodlight) adapters use them; the other\n          // vendors' fire accounting rides the per-fire metric relay,\n          // and their observer patterns land with each vendor's\n          // verified beacon hosts at go-live.\n          registerPixelFireId: function (vendor, pixelId) {\n            if (typeof vendor !== \"string\" || vendor.length === 0) return;\n            if (typeof pixelId !== \"string\" || pixelId.length === 0) return;\n            // First registration wins; own-property lookup so a name\n            // like \"constructor\" cannot read through the prototype.\n            if (!Object.prototype.hasOwnProperty.call(pixelFirePixelIds, vendor)) {\n              pixelFirePixelIds[vendor] = pixelId;\n            }\n            startPixelFireObserver();\n          },\n\n          attemptPixelFire: function (vendor) {\n            if (typeof vendor !== \"string\") return;\n            if (!Object.prototype.hasOwnProperty.call(pixelFirePixelIds, vendor)) {\n              return;\n            }\n            pixelAttempt(pixelFirePixelIds[vendor]);\n          },\n        };\n\n        // Listen for messages from parent\n        function handleMessage(event) {\n          // Security check: validate the origin is from the same base domain\n          // Allow both same-origin (for localhost) and parent domain (for a.subdomain setup)\n          const currentOrigin = window.location.origin;\n          const currentHostname = window.location.hostname;\n          const eventHostname = new URL(event.origin).hostname;\n\n          // Extract base domain (remove 'a.' prefix if present)\n          const baseDomain = currentHostname.startsWith(\"a.\")\n            ? currentHostname.substring(2)\n            : currentHostname;\n          const eventBaseDomain = eventHostname.startsWith(\"a.\")\n            ? eventHostname.substring(2)\n            : eventHostname;\n\n          // Allow messages from same origin or from parent domain\n          const isValidOrigin =\n            event.origin === currentOrigin || eventBaseDomain === baseDomain;\n\n          if (!isValidOrigin) {\n            logDebug(\"Message rejected - invalid origin\", {\n              expected: currentOrigin,\n              expectedBaseDomain: baseDomain,\n              received: event.origin,\n              receivedBaseDomain: eventBaseDomain,\n            });\n            return;\n          }\n\n          const data = event.data;\n\n          if (data.target !== \"isolated-segment\") {\n            logDebug(\"Message not for isolated-segment, ignoring\", {\n              target: data.target,\n            });\n            return;\n          }\n\n          // Full-payload logging only AFTER the namespace check: other\n          // buses' messages cross this frame too — notably the ATM init,\n          // which carries the per-session envelope auth token — and\n          // vendor scripts run here, so nothing that isn't ours gets its\n          // payload echoed to the console.\n          logDebug(\"Message received from parent\", {\n            origin: event.origin,\n            data: event.data,\n          });\n\n          logDebug(\"Processing message\", { type: data.type });\n\n          switch (data.type) {\n            case \"init\":\n              // Don't log before init is called\n              window.isolatedSegment.init(\n                data.writeKey,\n                data.cdnHost,\n                data.gtagMeasurementId,\n                data.floodlightId,\n                data.gtagMccMeasurementId,\n              );\n              break;\n\n            case \"track\":\n              logDebug(\"Handling track message\", { event: data.event });\n              window.isolatedSegment.track(\n                data.event,\n                data.properties,\n                data.options,\n              );\n              break;\n\n            case \"identify\":\n              logDebug(\"Handling identify message\", { userId: data.userId });\n              window.isolatedSegment.identify(data.userId, data.traits);\n              break;\n\n            default:\n              logDebug(\"Unknown message type\", { type: data.type });\n              break;\n          }\n        }\n\n        if (legacyBusEnabled) {\n          window.addEventListener(\"message\", handleMessage);\n        }\n\n        function sendReadyMessage() {\n          logDebug(\"Sending iframe_ready message\");\n          if (!window.isolatedSegment.initialized) {\n            window.isolatedSegment.sendMessage({\n              type: \"iframe_ready\",\n              timestamp: new Date().toISOString(),\n            });\n          } else if (readyInterval) {\n            clearInterval(readyInterval);\n            readyInterval = null;\n          }\n        }\n\n        // Notify parent that iframe is ready after DOM is loaded. Hosts\n        // without the legacy bus skip the announce loop along with the\n        // listener: no parent speaks this bus there.\n        if (legacyBusEnabled) {\n          if (document.readyState === \"loading\") {\n            document.addEventListener(\"DOMContentLoaded\", function () {\n              sendReadyMessage();\n              // Keep sending every 500ms until initialized\n              readyInterval = setInterval(sendReadyMessage, 500);\n            });\n          } else {\n            // DOM is already loaded\n            sendReadyMessage();\n            // Keep sending every 500ms until initialized\n            readyInterval = setInterval(sendReadyMessage, 500);\n          }\n        }\n      })();\n    </script>\n    <script>\n      (function () {\n        // --- ATM (Ant Tag Manager) consumer ---------------------------\n        // Receiving endpoint for the parent-page atmBridge feeder\n        // (packages/antalytics-react/src/atmBridge.ts). This is a\n        // PARALLEL listener to the isolated-segment handler above — the\n        // two buses share the frame but nothing else: different target\n        // namespace (\"atm-bridge\"), own origin gate, own handshake.\n        // Validated envelopes are kept in a bounded dev-visible sink\n        // (window.atmConsumer.received + console.debug) and then\n        // EXECUTED: each destination entry routes to its vendor\n        // adapter (see VENDOR_ADAPTERS below); destinations with no\n        // adapter are inert by design - the parent may declare routing\n        // for vendors this build does not carry yet, and the two\n        // sides roll independently.\n        function logDebug(message, ...args) {\n          console.debug(\"[AtmConsumer]\", message, ...args);\n        }\n\n        // Window.parent is a [Replaceable] attribute: any in-frame vendor\n        // script can assign window.parent = window and then self-post a\n        // GENUINE (isTrusted, same-origin) message whose source equals the\n        // replaced value — so every sender comparison and outbound post\n        // below uses this eval-time capture, never a live window.parent\n        // read. LOAD-BEARING ORDER: this inline script MUST stay ahead of\n        // any third-party script tag in this document — the capture is\n        // genuine only because it runs before vendor code can touch the\n        // global. (Verified at introduction: the only earlier inline\n        // blocks are this page's own first-party Segment shim and legacy\n        // handler; vendor bundles load asynchronously after.)\n        var realParent = window.parent;\n\n        // The wire protocol with the parent-page bridge: target\n        // namespaces the bus (this and the legacy isolated-segment\n        // listener ignore each other's messages by it); the three types\n        // are the event envelope and the two handshake legs (iframe\n        // announces ready until the parent acks init). These mirror the\n        // ATM_BRIDGE_* constants exported from\n        // packages/antalytics-react/src/atmBridge.ts — duplicated as\n        // literals because this standalone page has no build step to\n        // import through; the cross-side agreement is pinned by\n        // apps/claude-ai/src/atmConsumer.test.ts, which drives\n        // THIS script with the bridge package's exported constants.\n        var MESSAGE_TARGET = \"atm-bridge\";\n        // v2: the envelope is a resolved instruction — it carries the\n        // event's destination list (with per-destination enriched\n        // values) and this side executes it with no routing config of\n        // its own (its only local table is the build-pinned pixel-id\n        // allowlist in the executor below, a bound, not routing).\n        // The version lives in the type string: a v1-only consumer\n        // would drop v2 envelopes as an unknown type and vice versa, so\n        // the two sides can land and roll independently.\n        var EVENT_MESSAGE_TYPE = \"atm.analytics_event.v2\";\n        var READY_MESSAGE_TYPE = \"atm.ready.v1\";\n        var INIT_MESSAGE_TYPE = \"atm.init.v1\";\n        // iframe → parent: one rejected-message or adapter-failure\n        // count (enum only, no content); this sandboxed page has no\n        // Datadog SDK, so the parent emits to RUM on our behalf.\n        // Mirrors ATM_BRIDGE_METRIC_MESSAGE_TYPE in atmBridge.ts; the\n        // reason values mirror ATM_CONSUMER_REJECT_REASONS and the\n        // parent drops anything outside that closed set.\n        var METRIC_MESSAGE_TYPE = \"atm.metric.v1\";\n        // iframe -> parent: one pixel-fire record per vendor pixel\n        // call an adapter makes - {source, type, event, destination,\n        // pixel_id}. Every field names config the parent itself\n        // resolved onto the instruction (the event allowlist, the\n        // routing entry, ATM_VENDOR_PIXEL_IDS), so the parent\n        // re-validates each against its own config and drops anything\n        // it cannot ground-truth. Mirrors\n        // ATM_BRIDGE_PIXEL_FIRE_MESSAGE_TYPE in atmBridge.ts.\n        var PIXEL_FIRE_MESSAGE_TYPE = \"atm.pixel_fire.v1\";\n        // Defensive cap on a v2 envelope's destination list. The bridge\n        // can only produce as many entries as the event's config\n        // declares (single digits); a forged message could send\n        // thousands. Generous multiple of any plausible config size.\n        var DESTINATIONS_MAX = 32;\n        // Defensive caps on one entry's pixel_ids list (count, and each\n        // id's length). Real pixel ids are short numeric strings and a\n        // vendor needs a handful of datasets at most; a forged message\n        // could send thousands of long strings.\n        var PIXEL_IDS_MAX = 10;\n        var PIXEL_ID_LENGTH_MAX = 64;\n        var RECEIVED_MAX = 50;\n        // Reject-metric posts are capped per page load: enough to see a\n        // real probe or contract break in RUM, bounded if something\n        // spams forged messages at the frame.\n        var METRICS_MAX = 100;\n        // Pixel-fire posts ride their own budget: fires are expected\n        // and repeat per routed event (SPA navigations), so a budget\n        // shared with METRICS_MAX would let normal fire volume blind\n        // the reject counts, and a reject flood blind the fire counts.\n        var PIXEL_FIRE_METRICS_MAX = 100;\n        // Closure-local on purpose: this is the cap's authoritative\n        // state, and the other scripts in this frame are exactly the\n        // untrusted code the cap bounds — a window-global counter would\n        // hand them the reset knob. The dev-visible mirror below is a\n        // getter-only, non-configurable view of this variable.\n        var metricsPosted = 0;\n        // Closure-local like metricsPosted, and for the same reason:\n        // the cap's authoritative state must be out of reach of the\n        // vendor code it bounds. Dev-visible mirror below.\n        var pixelFireMetricsPosted = 0;\n        // Stop announcing after ~30s: if the parent hasn't acked by then,\n        // its ATM handler isn't mounted this page load (flag off or old\n        // parent) and never will be — the feeder gate is captured at the\n        // provider's one-shot init, so a mid-session flip only takes\n        // effect on the next load, which boots a fresh frame anyway.\n        var READY_MAX_ATTEMPTS = 60;\n        var readyAttempts = 0;\n        // Caps on the init-delivered killswitch snapshot (same doctrine\n        // as DESTINATIONS_MAX — a forged init could send anything):\n        // accepted ids, per-id length, and raw entries examined before\n        // the scan gives up.\n        var KILLED_PIXEL_IDS_MAX = 64;\n        var KILLED_PIXEL_ID_LENGTH_MAX = 64;\n        var KILLED_PIXEL_IDS_SCAN_MAX = 256;\n\n        var readyInterval = null;\n        // The marketing zones serve real traffic on both the bare and\n        // the www parent hosts; www handling below is scoped to exactly\n        // those zones so the claude.ai family's behavior stays\n        // byte-identical.\n        var MARKETING_PARENT_DOMAINS = [\"claude.com\", \"anthropic.com\"];\n\n        // Outbound origin pin (the bus spec pins BOTH directions; the\n        // legacy isolated-segment sendMessage's \"*\" is deliberately not\n        // copied). Before any inbound message exists, the parent origin\n        // candidates are derived from our own hostname: this frame is\n        // served from a.<parent-domain>, so stripping the \"a.\" prefix\n        // names the parent domain — and on the marketing zones the www\n        // form is a second candidate, because the embedding page may be\n        // either host (same-origin dev keeps location.origin). Pre-init\n        // outbound posts once per candidate; postMessage with a\n        // non-matching targetOrigin is silently dropped, so only the\n        // real parent ever receives anything. After a validated init\n        // arrives, the candidates collapse to that event's exact\n        // origin.\n        var parentOrigins = (function () {\n          var host = window.location.hostname;\n          if (host.indexOf(\"a.\") === 0) {\n            var base = host.substring(2);\n            var basePort = base +\n              (window.location.port ? \":\" + window.location.port : \"\");\n            var candidates = [window.location.protocol + \"//\" + basePort];\n            if (MARKETING_PARENT_DOMAINS.indexOf(base) !== -1) {\n              candidates.push(window.location.protocol + \"//www.\" + basePort);\n            }\n            return candidates;\n          }\n          return [window.location.origin];\n        })();\n\n        window.atmConsumer = {\n          received: [],\n        };\n        // Dev-visible, tamper-resistant mirrors of the consumer's\n        // security-relevant state: getter-only and non-configurable, so\n        // frame scripts can read but cannot write or redefine them — and\n        // even replacing window.atmConsumer wholesale cannot touch the\n        // closure variables the enforcement paths read.\n        Object.defineProperty(window.atmConsumer, \"initialized\", {\n          enumerable: true,\n          get: function () {\n            return initialized;\n          },\n        });\n        Object.defineProperty(window.atmConsumer, \"metricsPosted\", {\n          enumerable: true,\n          get: function () {\n            return metricsPosted;\n          },\n        });\n        Object.defineProperty(window.atmConsumer, \"pixelFireMetricsPosted\", {\n          enumerable: true,\n          get: function () {\n            return pixelFireMetricsPosted;\n          },\n        });\n        Object.defineProperty(window.atmConsumer, \"killedPixelIds\", {\n          enumerable: true,\n          get: function () {\n            // A fresh copy per read: the closure array stays the\n            // authoritative state, out of frame scripts' reach.\n            return killedPixelIds.slice();\n          },\n        });\n\n        // Per-session envelope auth token, learned ONLY from a validated\n        // init (authenticated by origin gate + sender check). Envelopes\n        // must carry it; before init none exists, so pre-init envelopes\n        // are dropped — the parent sends init before it flushes any\n        // envelope, and postMessage order is preserved, so nothing\n        // legitimate is lost. (Keep doc\n        // security/aki-security-index/products/claude-ai-web.md §6 /\n        // CLAU-AI-WEB-06: privileged channels authenticate messages\n        // with per-session tokens; the envelope carries routing\n        // authority, so the origin gate alone is not the whole gate.)\n        var sessionToken = null;\n\n        // First-init latch, closure-local for the same reason as\n        // sessionToken and metricsPosted: it enforces the token-binding\n        // property (CLAU-AI-WEB-06 — the token stays bound to the\n        // handshake that earned it), and in-frame vendor scripts are\n        // exactly the code that must not be able to reset it. The\n        // dev-visible window.atmConsumer.initialized is a getter-only\n        // mirror of this variable.\n        var initialized = false;\n\n        // Per-pixel killswitch snapshot, learned ONLY from the validated\n        // init; the parent-side fan-out check in atmBridge is the live,\n        // authoritative enforcement, and the adapter router in\n        // executeInstruction consults this at fire time as redundancy\n        // for envelopes that crossed before the list did. Closure-local\n        // like sessionToken, with a getter-only mirror below: in-frame\n        // vendor scripts may read which ids are killed, never un-kill\n        // them.\n        var killedPixelIds = [];\n\n        // Report one reject to the parent for Datadog emission (see\n        // METRIC_MESSAGE_TYPE above). Counts only — the rejected\n        // message's content never rides along. Uses the same outbound\n        // origin pin as the ready loop: before init that is the derived\n        // parent origin; a page load whose parent has no ATM handler\n        // mounted simply drops these, which is the fail-safe direction.\n        function postMetric(reason) {\n          if (metricsPosted >= METRICS_MAX) {\n            return;\n          }\n          metricsPosted += 1;\n          for (var i = 0; i < parentOrigins.length; i++) {\n            // Per-candidate try: one failing post must not starve the\n            // other candidate of the same message.\n            try {\n              realParent.postMessage(\n                { source: MESSAGE_TARGET, type: METRIC_MESSAGE_TYPE, metric: reason },\n                parentOrigins[i],\n              );\n            } catch (e) {\n              logDebug(\"Failed to post metric to parent\", { error: String(e) });\n            }\n          }\n        }\n\n        // State-like adapter conditions repeat per routed event (a\n        // dormant vendor sees every event routed to it), so each such\n        // reason posts once per page load; unlatched, a busy session\n        // would exhaust METRICS_MAX with an expected state and blind\n        // the relay's reject counts. adapter_failed stays\n        // per-occurrence (see executeInstruction): a throw is\n        // exceptional and its volume is the signal. Null-prototype for\n        // the same reason as initializedMetaPixelIds below.\n        var adapterConditionPosted = Object.create(null);\n        function postAdapterCondition(reason) {\n          if (adapterConditionPosted[reason]) return;\n          adapterConditionPosted[reason] = true;\n          postMetric(reason);\n        }\n\n        // Report one pixel fire to the parent for Datadog emission\n        // (see PIXEL_FIRE_MESSAGE_TYPE above). Per-occurrence on\n        // purpose, unlike the latched state-like conditions: the count\n        // IS the signal - fire volume per (event, destination,\n        // pixel id), read against the parent's delivery counts and the\n        // legacy observer's pixel_observed. Same outbound origin pin\n        // and fail-safe drop direction as postMetric.\n        function postPixelFireMetric(eventName, destination, pixelId) {\n          if (pixelFireMetricsPosted >= PIXEL_FIRE_METRICS_MAX) {\n            return;\n          }\n          pixelFireMetricsPosted += 1;\n          for (var i = 0; i < parentOrigins.length; i++) {\n            try {\n              realParent.postMessage(\n                {\n                  source: MESSAGE_TARGET,\n                  type: PIXEL_FIRE_MESSAGE_TYPE,\n                  event: eventName,\n                  destination: destination,\n                  pixel_id: pixelId,\n                },\n                parentOrigins[i],\n              );\n            } catch (e) {\n              logDebug(\"Failed to post pixel-fire metric to parent\", {\n                error: String(e),\n              });\n            }\n          }\n        }\n\n        // Same base-domain rule as the isolated-segment gate above, with\n        // the two defects traced there guarded: a non-string or opaque\n        // \"null\" origin is rejected before new URL() can throw. One\n        // deliberate tightening over the legacy gate (security review on\n        // the enrichment change): a CROSS-origin embedder must also be\n        // https on this frame's own port — hostname alone is not a trust\n        // boundary (an http origin is MITM-forgeable; a different port is\n        // a different server). With scheme and port pinned, the\n        // base-domain branch accepts the parent this deployment embeds\n        // us under — on the marketing zones in its bare or www form\n        // (mirroring the outbound candidate pair), on every other host\n        // by the pre-existing base-domain rule, unchanged. The\n        // same-origin first branch is an exact match and does not\n        // require https, so local dev is unaffected.\n        function isAllowedOrigin(origin) {\n          if (typeof origin !== \"string\" || origin === \"null\" || origin === \"\") {\n            return false;\n          }\n          if (origin === window.location.origin) {\n            return true;\n          }\n          var originUrl;\n          try {\n            originUrl = new URL(origin);\n          } catch (e) {\n            return false;\n          }\n          if (\n            originUrl.protocol !== \"https:\" ||\n            originUrl.port !== window.location.port\n          ) {\n            return false;\n          }\n          var originHostname = originUrl.hostname;\n          var currentHostname = window.location.hostname;\n          var baseDomain = currentHostname.indexOf(\"a.\") === 0\n            ? currentHostname.substring(2)\n            : currentHostname;\n          if (MARKETING_PARENT_DOMAINS.indexOf(baseDomain) !== -1) {\n            // Marketing zones: exact two-candidate match — the parent\n            // domain's bare form and its www form, mirroring the\n            // outbound candidate pair above. Exact equality, no suffix\n            // matching, and no stripping of the ORIGIN's own labels, so\n            // evil-claude.com, claude.com.evil forms, and nested\n            // a./www. combinations (a.www.claude.com) all stay\n            // rejected.\n            return (\n              originHostname === baseDomain ||\n              originHostname === \"www.\" + baseDomain\n            );\n          }\n          // claude.ai family: the pre-existing base-domain rule,\n          // unchanged — www.claude.ai stays rejected exactly as before.\n          var originBaseDomain = originHostname.indexOf(\"a.\") === 0\n            ? originHostname.substring(2)\n            : originHostname;\n          return originBaseDomain === baseDomain;\n        }\n\n        // --- vendor adapters -------------------------------------------\n        // Adapters EXECUTE the envelope's resolved instruction: for each\n        // destinations[] entry the router below calls that vendor's\n        // adapter with the validated envelope and that entry. The parent\n        // dictates WHERE an event goes AND which pixel/tag ids it fires\n        // for - the entry's `pixel_ids`, resolved parent-side from the\n        // single config source (ATM_VENDOR_PIXEL_IDS in atmConfig.ts),\n        // so this side carries no per-product ids of its own. An entry\n        // that arrives without ids keeps that adapter DORMANT: it logs\n        // and fires nothing, and loads no vendor code. (The legacy gtag\n        // AW-/DC- ids in the block above predate this contract and move\n        // out when those products' ATM adapters land.) The adapter owns\n        // HOW its vendor is called - vendor API shape and the\n        // event-name mapping below. The legacy gtag block above still\n        // fires the same Google accounts on its own bus: activating\n        // the ATM Google ids without retiring the matching legacy\n        // resolvers double-fires every conversion, so each Google\n        // go-live retires its legacy resolver in the same release.\n\n        // The vendor event names this adapter knows how to fire, in\n        // Meta's own vocabulary. The envelope entry carries WHICH name\n        // to fire (vendor_event, config-declared parent-side); this\n        // set is the iframe's guard that only known Meta events ever\n        // reach fbq - an absent or unlisted value is dropped, never\n        // forwarded as a guessed custom event. Vendor vocabulary is\n        // stable, so this set only grows when a Meta event TYPE is\n        // first used; onboarding an envelope event is config-only.\n        var META_ALLOWED_VENDOR_EVENTS = {\n          PageView: true,\n          Purchase: true,\n          CompleteRegistration: true,\n        };\n        // Meta dataset ids are numeric; same pre-fire guard class as\n        // every other adapter, so a forged envelope's arbitrary string\n        // never reaches fbq and is counted like any other bad id. The\n        // 13-17 digit bound is a heuristic from observed ids - Meta's\n        // docs show only placeholders, no id format - so widen it if a\n        // real dataset id ever falls outside it.\n        var META_PIXEL_ID_PATTERN = /^[0-9]{13,17}$/;\n        // Meta pixel ids already init'ed on the shared fbq queue, so a\n        // fan-out to several datasets inits each exactly once.\n        // Null-prototype: ids are envelope strings, and a name like\n        // \"constructor\" must behave like any other id.\n        var initializedMetaPixelIds = Object.create(null);\n\n        // Install the standard fbq command-queue stub and start loading\n        // fbevents.js (CSP: script-src already carries\n        // connect.facebook.net; the /tr fires it makes are covered by\n        // img-src * and connect-src *.facebook.com). Readable version\n        // of Meta's minified base snippet; the stub queues calls until\n        // fbevents.js swaps in callMethod, so call order is preserved.\n        function ensureMetaPixelBase() {\n          if (window.fbq) {\n            return;\n          }\n          var fbq = function () {\n            if (fbq.callMethod) {\n              fbq.callMethod.apply(fbq, arguments);\n            } else {\n              fbq.queue.push(arguments);\n            }\n          };\n          fbq.push = fbq;\n          fbq.loaded = true;\n          fbq.version = \"2.0\";\n          fbq.queue = [];\n          window.fbq = fbq;\n          if (!window._fbq) {\n            window._fbq = fbq;\n          }\n          var scriptTag = document.createElement(\"script\");\n          scriptTag.async = true;\n          scriptTag.src = \"https://connect.facebook.net/en_US/fbevents.js\";\n          var firstScript = document.getElementsByTagName(\"script\")[0];\n          if (firstScript && firstScript.parentNode) {\n            firstScript.parentNode.insertBefore(scriptTag, firstScript);\n          } else {\n            (document.head || document.documentElement).appendChild(scriptTag);\n          }\n        }\n\n        // Meta Pixel adapter. Fires for the ids the instruction's\n        // entry carries (config-declared parent-side, riding the\n        // envelope as `pixel_ids`): each id is init'ed lazily on its\n        // first firing instruction - a frame whose instructions never\n        // carry Meta ids never loads Meta code - then fired with ONE\n        // trackSingle per id, so a multi-dataset fan-out fires each\n        // dataset exactly once. The fbq eventID is the entry's own\n        // dedupe_id when the parent composed one for this destination,\n        // else the envelope's dedupe_id when the parent's config\n        // extracted one, else the client-minted event_id - the dedupe\n        // key Meta uses against a\n        // server-side CAPI twin of the same firing, within each\n        // dataset (Meta documents eventID as track's trailing options\n        // argument; passing the same trailing object to trackSingle is\n        // inferred from that, not shown verbatim in Meta's reference,\n        // and the Meta flip confirms the dedupe lands in Events\n        // Manager). trackSingle, not track: the window.fbq queue is\n        // shared - the legacy Segment block in this frame can put its\n        // own pixel on it (its Facebook destination is a dashboard\n        // toggle away), and this adapter itself can init several.\n        // Unscoped track fires on EVERY initialized pixel -\n        // cross-firing into foreign datasets, where the eventID can\n        // dedupe nothing; trackSingle pins each fire to its own id.\n        function runMetaPixelAdapter(envelope, entry) {\n          // Own-property check: vendor_event is shape-validated but\n          // content-free, and a prototype name (\"constructor\") must\n          // never read through to something truthy.\n          var metaEventName =\n            entry.vendor_event !== undefined &&\n            Object.prototype.hasOwnProperty.call(\n              META_ALLOWED_VENDOR_EVENTS,\n              entry.vendor_event,\n            )\n              ? entry.vendor_event\n              : undefined;\n          if (!metaEventName) {\n            logDebug(\"meta_pixel: no known vendor event on the entry, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n          var pixelIds = entry.pixel_ids;\n          if (!pixelIds || pixelIds.length === 0) {\n            logDebug(\"meta_pixel: dormant (no pixel ids on the instruction)\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_dormant\");\n            return;\n          }\n          // Pixel-fire telemetry, through the legacy block's hooks\n          // (the shared PerformanceObserver lives there; see\n          // registerPixelFireId on window.isolatedSegment). Registered\n          // as the constant \"fb\" rather than a numeric dataset id: the\n          // parent allowlists relayed pixel values against ids it can\n          // ground-truth, and a numeric id arriving from this frame\n          // (untrusted vendor JS runs here) is not one, so all Meta\n          // datasets share the one \"fb\" bucket exactly like the legacy\n          // path. One attempt is counted per trackSingle below, which\n          // makes a blocked fbevents.js load visible as\n          // attempt-without-observed. Per-id and per-event fire\n          // accounting rides the separate pixel-fire metric instead\n          // (postPixelFireMetric, one post per trackSingle): those\n          // values come from the parent's own config riding the\n          // instruction, so the parent CAN ground-truth them, which\n          // this legacy bucket's relay cannot.\n          var telemetry = window.isolatedSegment;\n          try {\n            if (telemetry && typeof telemetry.registerPixelFireId === \"function\") {\n              telemetry.registerPixelFireId(\"facebook\", \"fb\");\n            }\n          } catch {}\n          // Purchase carries the enriched value when the instruction\n          // has one; other events stay payload-free. Meta documents\n          // value and currency as required on Purchase, so a Purchase\n          // firing before value enrichment exists is incomplete by the\n          // spec (Events Manager warns rather than rejects); the Meta\n          // flip orders Purchase routing after that enrichment.\n          var metaPayload = {};\n          if (metaEventName === \"Purchase\" && typeof entry.value === \"number\") {\n            metaPayload = { value: entry.value, currency: \"USD\" };\n          }\n          for (var i = 0; i < pixelIds.length; i++) {\n            var pixelId = pixelIds[i];\n            if (!META_PIXEL_ID_PATTERN.test(pixelId)) {\n              logDebug(\"meta_pixel: rejecting malformed pixel id\");\n              postAdapterCondition(\"adapter_bad_pixel_id\");\n              continue;\n            }\n            if (!initializedMetaPixelIds[pixelId]) {\n              ensureMetaPixelBase();\n              window.fbq(\"init\", pixelId);\n              initializedMetaPixelIds[pixelId] = true;\n            }\n            try {\n              if (telemetry && typeof telemetry.attemptPixelFire === \"function\") {\n                telemetry.attemptPixelFire(\"facebook\");\n              }\n            } catch {}\n            window.fbq(\"trackSingle\", pixelId, metaEventName, metaPayload, {\n              eventID:\n                entry.dedupe_id || envelope.dedupe_id || envelope.event_id,\n            });\n            postPixelFireMetric(\n              envelope.event_name,\n              entry.destination,\n              pixelId,\n            );\n          }\n        }\n\n        // --- Google (gtag) shared base ---------------------------------\n        // Shared by the google_ads, google_floodlight and\n        // google_floodlight_sales adapters. The legacy isolated-segment\n        // block in this frame can have already\n        // installed window.gtag/dataLayer and loaded gtag.js for its\n        // own fires; the command queue is shared state, so this base\n        // reuses whatever exists and fills in only what is missing.\n        var configuredGtagIds = Object.create(null);\n        function ensureGtagBase(bootstrapId) {\n          if (typeof window.gtag !== \"function\") {\n            window.dataLayer = window.dataLayer || [];\n            window.gtag = function () {\n              window.dataLayer.push(arguments);\n            };\n            // Same consent defaults as the legacy block: the parent\n            // only renders this iframe when marketing consent is\n            // already granted.\n            window.gtag(\"consent\", \"default\", {\n              ad_personalization: \"granted\",\n              ad_user_data: \"granted\",\n              ad_storage: \"granted\",\n              analytics_storage: \"granted\",\n              functionality_storage: \"granted\",\n              personalization_storage: \"granted\",\n              security_storage: \"granted\",\n            });\n            window.gtag(\"js\", new Date());\n          }\n          // gtag.js is account-agnostic once loaded: any configured id\n          // serves as the bootstrap id, and one load serves every\n          // account configured after it - including a load the legacy\n          // block already made.\n          if (\n            !document.querySelector(\n              'script[src^=\"https://www.googletagmanager.com/gtag/js\"]',\n            )\n          ) {\n            var scriptTag = document.createElement(\"script\");\n            scriptTag.async = true;\n            scriptTag.src =\n              \"https://www.googletagmanager.com/gtag/js?id=\" + bootstrapId;\n            var firstScript = document.getElementsByTagName(\"script\")[0];\n            if (firstScript && firstScript.parentNode) {\n              firstScript.parentNode.insertBefore(scriptTag, firstScript);\n            } else {\n              (document.head || document.documentElement).appendChild(\n                scriptTag,\n              );\n            }\n          }\n        }\n        function ensureGtagConfigured(tagId) {\n          if (configuredGtagIds[tagId]) {\n            return;\n          }\n          ensureGtagBase(tagId);\n          // send_page_view false: ATM fires are envelope-driven only.\n          var options = { send_page_view: false };\n          if (tagId.indexOf(\"DC-\") === 0) {\n            options.allow_enhanced_conversions = true;\n          }\n          window.gtag(\"config\", tagId, options);\n          configuredGtagIds[tagId] = true;\n        }\n\n        // The gtag conversions this adapter fires arrive composed on\n        // the instruction (entry.send_to, one full send_to string per\n        // configured account that maps the event, resolved from parent\n        // config) - this side carries no label tables and composes\n        // nothing. Each string's account prefix must carry the right\n        // product prefix (AW-/DC-) and appear in the entry's OWN\n        // pixel_ids: an intra-envelope consistency check, so send_to\n        // can never widen beyond the entry's id list or cross\n        // destinations. A forger of the whole envelope controls both\n        // fields, but the executor's ATM_PIXEL_ID_ALLOWLIST gate pins\n        // the entry's ids - and through this check every firing\n        // send_to account - to the reviewed config.\n        var GTAG_SEND_TO_PATTERN = /^(AW|DC)-[0-9]{1,16}\\/[A-Za-z0-9+_\\/-]{1,80}$/;\n        // The Floodlight counting method is the send_to's \"+\" suffix\n        // (DC-1234/group/activity+transactions); null when there is none.\n        function floodlightCountingMethod(sendTo) {\n          var plus = sendTo.lastIndexOf(\"+\");\n          return plus === -1 ? null : sendTo.slice(plus + 1);\n        }\n        function runGtagSendToAdapter(envelope, entry, accountPrefix) {\n          var pixelIds = entry.pixel_ids;\n          if (!pixelIds || pixelIds.length === 0) {\n            logDebug(entry.destination + \": dormant (no pixel ids on the instruction)\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_dormant\");\n            return;\n          }\n          var sendToList = entry.send_to;\n          if (!sendToList || sendToList.length === 0) {\n            // The config maps no configured account to this event for\n            // this destination - nothing to fire. Dormancy is checked\n            // first: a routed-but-dormant entry carries neither ids\n            // nor send_to, and dormant is its meaningful state.\n            logDebug(entry.destination + \": no send_to for this event, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n          for (var i = 0; i < sendToList.length; i++) {\n            var sendTo = sendToList[i];\n            var accountId = sendTo.split(\"/\")[0];\n            if (\n              accountId.indexOf(accountPrefix) !== 0 ||\n              !GTAG_SEND_TO_PATTERN.test(sendTo) ||\n              pixelIds.indexOf(accountId) === -1\n            ) {\n              logDebug(entry.destination + \": rejecting malformed or unconfigured send_to\");\n              postAdapterCondition(\"adapter_bad_pixel_id\");\n              continue;\n            }\n            ensureGtagConfigured(accountId);\n            // Floodlight: no allow_custom_scripts. Campaign Manager's\n            // generated snippets include it, but it only enables dynamic\n            // (custom-script) tags, which these activities do not use.\n            // The call shape follows the activity's counting method, as\n            // Campaign Manager's own snippets do: a +transactions sales\n            // activity is gtag(\"event\", \"purchase\", {transaction_id,\n            // dc_custom_params: {match_id}, send_to}); every other\n            // method, and every Google Ads label, is the counter shape\n            // gtag(\"event\", \"conversion\"). +items_sold (needs quantity)\n            // and +per_session (needs session_id) are not routed\n            // (https://support.google.com/campaignmanager/answer/7554821).\n            var payload = { send_to: sendTo };\n            var isGoogleAds = accountPrefix === \"AW-\";\n            var isFloodlightSale =\n              accountPrefix === \"DC-\" &&\n              floodlightCountingMethod(sendTo) === \"transactions\";\n            // The dedupe key for this fire: the entry's own id when the\n            // parent composed one for this destination, else the\n            // envelope's shared id. Omitted when neither was extracted -\n            // an empty constant would collapse every such conversion\n            // into one.\n            var dedupeId = entry.dedupe_id || envelope.dedupe_id;\n            if (isGoogleAds) {\n              // Until enrichment carries a per-plan value on\n              // entry.value, 1.0 matches what the legacy block sends\n              // Google Ads.\n              payload.value =\n                typeof entry.value === \"number\" ? entry.value : 1.0;\n              if (dedupeId) {\n                payload.transaction_id = dedupeId;\n              }\n              payload.currency = \"USD\";\n            }\n            if (isFloodlightSale) {\n              // No value, by decision: the sale's value reaches Campaign\n              // Manager through the server-side upload keyed by the same\n              // id, so the pixel carries the key alone, in both fields\n              // Google reads it from - transaction_id (the activity\n              // request's ord=) for the upload and for counting\n              // conversions the tag missed, match_id for tag-matched\n              // attribution. match_id rides in dc_custom_params, the\n              // Google tag's general carrier for Floodlight request\n              // parameters, whose entries the tag appends to the\n              // activity request as key=value (so this is meant to land\n              // as match_id=). That carrier is the team's current\n              // reading, not yet confirmed against a captured activity\n              // request or Google's exact snippet for this activity.\n              if (dedupeId) {\n                payload.transaction_id = dedupeId;\n                payload.dc_custom_params = { match_id: dedupeId };\n              }\n            }\n            // The legacy block's resource-timing observer counts every\n            // Google beacon from this frame as an observed fire; record\n            // the attempt under the same vendor keys so its\n            // attempt-to-observed ratio (the ad-blocker signal) stays\n            // whole, as the Meta adapter does.\n            try {\n              var telemetry = window.isolatedSegment;\n              var telemetryVendor = isGoogleAds ? \"google_ads\" : \"floodlight\";\n              if (telemetry && typeof telemetry.registerPixelFireId === \"function\") {\n                telemetry.registerPixelFireId(telemetryVendor, accountId);\n              }\n              if (telemetry && typeof telemetry.attemptPixelFire === \"function\") {\n                telemetry.attemptPixelFire(telemetryVendor);\n              }\n            } catch {}\n            window.gtag(\n              \"event\",\n              isFloodlightSale ? \"purchase\" : \"conversion\",\n              payload,\n            );\n            postPixelFireMetric(\n              envelope.event_name,\n              entry.destination,\n              accountId,\n            );\n          }\n        }\n        function runGoogleAdsAdapter(envelope, entry) {\n          runGtagSendToAdapter(envelope, entry, \"AW-\");\n        }\n        function runGoogleFloodlightAdapter(envelope, entry) {\n          runGtagSendToAdapter(envelope, entry, \"DC-\");\n        }\n\n        // The Reddit events this adapter knows how to fire, in\n        // Reddit's own vocabulary; the entry's config-declared\n        // vendor_event names which one. \"Lead\" is deliberately absent:\n        // no envelope event exists to route it from.\n        var REDDIT_ALLOWED_VENDOR_EVENTS = {\n          PageVisit: true,\n          Purchase: true,\n        };\n        var REDDIT_PIXEL_ID_PATTERN = /^[A-Za-z0-9_-]{1,64}$/;\n        var initializedRedditPixelIds = Object.create(null);\n        // Readable version of Reddit's minified base snippet: commands\n        // queue until pixel.js swaps in sendEvent, so call order is\n        // preserved.\n        function ensureRedditBase() {\n          if (window.rdt) {\n            return;\n          }\n          var rdt = function () {\n            if (rdt.sendEvent) {\n              rdt.sendEvent.apply(rdt, arguments);\n            } else {\n              rdt.callQueue.push(arguments);\n            }\n          };\n          rdt.callQueue = [];\n          window.rdt = rdt;\n          var scriptTag = document.createElement(\"script\");\n          scriptTag.async = true;\n          scriptTag.src = \"https://www.redditstatic.com/ads/pixel.js\";\n          var firstScript = document.getElementsByTagName(\"script\")[0];\n          if (firstScript && firstScript.parentNode) {\n            firstScript.parentNode.insertBefore(scriptTag, firstScript);\n          } else {\n            (document.head || document.documentElement).appendChild(scriptTag);\n          }\n        }\n        function runRedditPixelAdapter(envelope, entry) {\n          var redditEventName =\n            entry.vendor_event !== undefined &&\n            Object.prototype.hasOwnProperty.call(\n              REDDIT_ALLOWED_VENDOR_EVENTS,\n              entry.vendor_event,\n            )\n              ? entry.vendor_event\n              : undefined;\n          if (redditEventName === undefined) {\n            logDebug(\"reddit_pixel: no known vendor event on the entry, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n          var pixelIds = entry.pixel_ids;\n          if (!pixelIds || pixelIds.length === 0) {\n            logDebug(\n              \"reddit_pixel: dormant (no pixel ids on the instruction)\",\n              { event: envelope.event_name },\n            );\n            postAdapterCondition(\"adapter_dormant\");\n            return;\n          }\n          var validPixelIds = [];\n          for (var i = 0; i < pixelIds.length; i++) {\n            var pixelId = pixelIds[i];\n            if (!REDDIT_PIXEL_ID_PATTERN.test(pixelId)) {\n              logDebug(\"reddit_pixel: rejecting malformed pixel id\");\n              postAdapterCondition(\"adapter_bad_pixel_id\");\n              continue;\n            }\n            validPixelIds.push(pixelId);\n            if (!initializedRedditPixelIds[pixelId]) {\n              ensureRedditBase();\n              // useDecimalCurrencyValues: makes the pixel read the\n              // value field as decimal currency (9.99 = $9.99),\n              // matching the decimal USD this adapter sends like the\n              // Meta and Google adapters. The option comes from the\n              // init line of Reddit's Events Manager install snippet\n              // (rdt('init', id, {optOut: false,\n              // useDecimalCurrencyValues: true})); Reddit's help\n              // center documents value as decimal but does not list\n              // this option by name.\n              window.rdt(\"init\", pixelId, { useDecimalCurrencyValues: true });\n              initializedRedditPixelIds[pixelId] = true;\n            }\n          }\n          if (validPixelIds.length === 0) {\n            return;\n          }\n          // ONE track per envelope: rdt has no per-id call scoping -\n          // every initialized id receives every track, so a per-id\n          // track loop would multiply fires. conversionId is the\n          // dedupe key Reddit matches against the server-side\n          // Conversions API twin of the same firing. Like the Meta and\n          // Google adapters, a valued instruction carries its value.\n          var redditPayload = {\n            conversionId:\n              entry.dedupe_id || envelope.dedupe_id || envelope.event_id,\n          };\n          if (typeof entry.value === \"number\") {\n            redditPayload.value = entry.value;\n            redditPayload.currency = \"USD\";\n          }\n          window.rdt(\"track\", redditEventName, redditPayload);\n          // One fire record per id the track reaches (all of them -\n          // the single call fans out vendor-side).\n          for (var j = 0; j < validPixelIds.length; j++) {\n            postPixelFireMetric(\n              envelope.event_name,\n              entry.destination,\n              validPixelIds[j],\n            );\n          }\n        }\n\n        // The ttq queue methods this adapter knows how to call; the\n        // entry's config-declared vendor_event names which one (\"page\"\n        // is ttq's page-view method). \"ViewContent\" stays absent until\n        // an envelope event exists to route it from.\n        var TIKTOK_ALLOWED_VENDOR_EVENTS = {\n          page: true,\n        };\n        // The sdkid is composed into the loader URL query; exact shape\n        // guard before composing.\n        var TIKTOK_PIXEL_ID_PATTERN = /^[A-Z0-9]{8,32}$/;\n        var loadedTiktokPixelIds = Object.create(null);\n        // Readable version of TikTok's minified base snippet: a command\n        // queue per pixel instance; events.js swaps in the real methods\n        // and drains the queues, so call order is preserved.\n        function ensureTiktokBase() {\n          if (window.ttq) {\n            return;\n          }\n          var methods = [\n            \"page\",\n            \"track\",