\n                ) {\n                  return null;\n                }\n                cleanPixelIds.push(pixelId);\n              }\n            }\n            var cleanEntry = { destination: destination };\n            if (vendorEvent !== undefined) {\n              cleanEntry.vendor_event = vendorEvent;\n            }\n            if (cleanSendTo !== undefined) {\n              cleanEntry.send_to = cleanSendTo;\n            }\n            var value = entry.value;\n            if (value !== undefined) {\n              if (typeof value !== \"number\" || !isFinite(value)) {\n                return null;\n              }\n              cleanEntry.value = value;\n            }\n            // A destination-scoped dedupe id is optional (present\n            // exactly when the parent's routing entry declares its own\n            // extraction), validated like the envelope-level one: a\n            // malformed value rejects the envelope whole.\n            var entryDedupeId = entry.dedupe_id;\n            if (entryDedupeId !== undefined) {\n              if (\n                typeof entryDedupeId !== \"string\" ||\n                entryDedupeId.length === 0 ||\n                entryDedupeId.length > 128\n              ) {\n                return null;\n              }\n              cleanEntry.dedupe_id = entryDedupeId;\n            }\n            if (cleanPixelIds !== undefined) {\n              cleanEntry.pixel_ids = cleanPixelIds;\n            }\n            cleanDestinations.push(cleanEntry);\n          }\n          var clean = {\n            event_name: name,\n            event_id: id,\n            event_timestamp: timestamp,\n            destinations: cleanDestinations,\n          };\n          if (dedupeId !== undefined) {\n            clean.dedupe_id = dedupeId;\n          }\n          return clean;\n        }\n\n        function handleAtmMessage(event) {\n          // Guard non-object data first: the legacy handler throws on\n          // string/null data; this one must not.\n          var data = event.data;\n          if (typeof data !== \"object\" || data === null || data.target !== MESSAGE_TARGET) {\n            return;\n          }\n          // Origin, source, and token are all forgeable from inside this\n          // frame: MessageEventInit accepts any origin string and any\n          // source (including the real window.parent). isTrusted is the\n          // one field a script cannot mint — browser-delivered postMessage\n          // events always carry true, constructor-built events always\n          // false — so synthetic in-frame dispatches bail here before they\n          // can reach the first-init latch (CLAU-AI-WEB-06).\n          if (event.isTrusted === false) {\n            logDebug(\"Message rejected - synthetic (untrusted) event\");\n            postMetric(\"untrusted_event\");\n            return;\n          }\n          if (!isAllowedOrigin(event.origin)) {\n            logDebug(\"Message rejected - invalid origin\", { received: event.origin });\n            postMetric(\"invalid_origin\");\n            return;\n          }\n          if (data.type === INIT_MESSAGE_TYPE) {\n            // First-init latch: the parent posts init exactly once per\n            // frame instance (remounts boot a fresh consumer), so a\n            // later init can only be another script at an allowed\n            // origin trying to swap in its own session token\n            // (CLAU-AI-WEB-06) — the token must stay bound to the\n            // handshake that earned it.\n            if (initialized) {\n              logDebug(\"Init rejected - already initialized\");\n              postMetric(\"init_duplicate\");\n              return;\n            }\n            // Strictness on the trust-establishing message: origin alone\n            // can be shared by sibling frames; the browser-set source\n            // must be the embedding parent itself.\n            if (event.source !== realParent) {\n              logDebug(\"Init rejected - sender is not the parent window\");\n              postMetric(\"init_bad_sender\");\n              return;\n            }\n            // The init must carry the session token the parent minted;\n            // an init without one is not something the parent produces.\n            if (\n              typeof data.token !== \"string\" ||\n              data.token.length === 0 ||\n              data.token.length > 128\n            ) {\n              logDebug(\"Init rejected - missing or malformed session token\");\n              postMetric(\"init_bad_token\");\n              return;\n            }\n            // Killswitch snapshot off the validated init: bounded,\n            // strings only. Anything malformed degrades to an empty\n            // snapshot, never a rejected init — a redundancy field must\n            // not be able to break the handshake.\n            var killedRaw = data.killed_pixel_ids;\n            if (Array.isArray(killedRaw)) {\n              var killedScanMax = killedRaw.length < KILLED_PIXEL_IDS_SCAN_MAX\n                ? killedRaw.length\n                : KILLED_PIXEL_IDS_SCAN_MAX;\n              for (var ki = 0; ki < killedScanMax; ki++) {\n                if (killedPixelIds.length >= KILLED_PIXEL_IDS_MAX) {\n                  break;\n                }\n                var killedId = killedRaw[ki];\n                if (\n                  typeof killedId === \"string\" &&\n                  killedId.length > 0 &&\n                  killedId.length <= KILLED_PIXEL_ID_LENGTH_MAX\n                ) {\n                  killedPixelIds.push(killedId);\n                }\n              }\n            }\n            sessionToken = data.token;\n            initialized = true;\n            // Pin all further outbound to the proven parent origin.\n            parentOrigins = [event.origin];\n            if (readyInterval) {\n              clearInterval(readyInterval);\n              readyInterval = null;\n            }\n           