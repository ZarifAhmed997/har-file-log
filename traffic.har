se},\"3742613268\":{\"defaultValue\":false},\"3743185903\":{\"defaultValue\":false},\"3750794682\":{\"defaultValue\":false},\"3750820388\":{\"defaultValue\":{\"tools\":{\"memory_append\":{\"kind\":\"write\"},\"memory_delete\":{\"kind\":\"delete\"},\"memory_list\":{\"kind\":\"list\"},\"memory_read\":{\"kind\":\"read\"},\"memory_search\":{\"kind\":\"search\"},\"memory_str_replace\":{\"kind\":\"write\"},\"memory_write\":{\"kind\":\"write\"}}}},\"3752128051\":{\"defaultValue\":true},\"3753357280\":{\"defaultValue\":true},\"3753610559\":{\"defaultValue\":{\"cinder_bramble_vane\":\"This session was created without a budget\",\"flint_hollow_pike\":\"Budget amount\",\"harbor_willow_dusk\":\"Cost is priced at public list rates, before any negotiated discounts. Session budget is shown if set.\",\"juniper_slate_ferry\":\"This session has reached its budget and can’t accept new events\",\"lantern_marsh_quill\":\"See what each session costs at list rates, and cap spend by giving a session a budget when you create it.\",\"opal_thicket_drift\":\"Budget\",\"pewter_thistle_run\":\"New: Session budgets\",\"russet_beacon_glade\":\"Stop the session once it reaches this cost, priced at public list rates. Leave empty for no limit.\",\"sable_ridge_kettle\":\"Edit budget\",\"verdant_quarry_lace\":\"Budget updated.\"}},\"3753854569\":{\"defaultValue\":true},\"3759431833\":{\"defaultValue\":{}},\"3762988844\":{\"defaultValue\":false},\"3763843891\":{\"defaultValue\":false},\"3763876911\":{\"defaultValue\":false},\"3768234728\":{\"defaultValue\":true},\"3769441463\":{\"defaultValue\":true},\"3771872978\":{\"defaultValue\":false},\"3773164847\":{\"defaultValue\":{\"enabled\":true}},\"3773215883\":{\"defaultValue\":{\"marketing_url\":\"\",\"prompt\":\"Export all of my stored memories and any context you've learned about me from past conversations. Preserve my words verbatim where possible, especially for instructions and preferences.\\n\\n## Categories (output in this order):\\n\\n1. **Instructions**: Rules I've explicitly asked you to follow going forward — tone, format, style, \\\"always do X\\\", \\\"never do Y\\\", and corrections to your behavior. Only include rules from stored memories, not from conversations.\\n\\n2. **Identity**: Name, age, location, education, family, relationships, languages, and personal interests.\\n\\n3. **Career**: Current and past roles, companies, and general skill areas.\\n\\n4. **Projects**: Projects I meaningfully built or committed to. Ideally ONE entry per project. Include what it does, current status, and any key decisions. Use the project name or a short descriptor as the first words of the entry.\\n\\n5. **Preferences**: Opinions, tastes, and working-style preferences that apply broadly.\\n\\n## Format:\\n\\nUse section headers for each category. Within each category, list one entry per line, sorted by oldest date first. Format each line as:\\n\\n[YYYY-MM-DD] - Entry content here.\\n\\nIf no date is known, use [unknown] instead.\\n\\n## Output:\\n- Wrap the entire export in a single code block for easy copying.\\n- After the code block, state whether this is the complete set or if more remain.\"}},\"3774822426\":{\"defaultValue\":false},\"3775627441\":{\"defaultValue\":true},\"3779176990\":{\"defaultValue\":true},\"3779525490\":{\"defaultValue\":true},\"3780221749\":{\"defaultValue\":true,\"rules\":[{\"force\":true,\"tracks\":[{\"experiment\":{\"hashAttribute\":\"id\",\"key\":\"claude_science_promo_end_user\",\"variations\":[false,true]},\"result\":{\"featureId\":\"3780221749\",\"hashAttribute\":\"id\",\"hashUsed\":true,\"hashValue\":\"95cdd3ba-7cd6-4367-b3bf-0d00847b6633\",\"inExperiment\":true,\"key\":\"1\",\"value\":true,\"variationId\":1}}]}]},\"3780385272\":{\"defaultValue\":{\"variant\":\"v2\"}},\"3780456914\":{\"defaultValue\":false},\"3783250119\":{\"defaultValue\":false},\"3784682118\":{\"defaultValue\":false},\"3786726740\":{\"defaultValue\":{}},\"3788554524\":{\"defaultValue\":true},\"3800563892\":{\"def