            "text": "{\"experiences\":[{\"id\":\"751b5f08-7f97-4bba-8c7d-82def4a8a9a3\",\"key\":\"ember-lynx-meadow\",\"content\":{\"title\":\"Claude Fable 5.1 is now available\",\"layout\":\"horizontal\",\"assetAlt\":\"\",\"assetFit\":\"cover\",\"assetUrl\":\"https://assets.claude.ai/images/model-spotlight-2x-0d3c3aa7.png\",\"videoUrl\":\"https://assets.claude.ai/videos/model-spotlight-tight-392a3325.mp4\",\"badgeText\":\"NEW\",\"ctaActions\":[{\"text\":\"Upgrade to try\",\"type\":\"upgrade\",\"value\":\"/upgrade?from=spotlight&feature=fable51&recommendedPlan=max\",\"nuxText\":\"You're on Fable 5.1\",\"isPrimary\":true,\"nuxBadgeText\":\"New\",\"postActionModel\":\"claude-fable-5-1\"}],\"ctaCaption\":\"Fable 5.1 is included in Max plans, or available with usage credits on Pro.\",\"panelSplit\":\"1:1\",\"dismissText\":\"Later\",\"bulletPoints\":[{\"icon\":\"Chat\",\"text\":\"Sticks to what you asked for and asks when it's unclear\"},{\"icon\":\"Spreadsheet\",\"text\":\"Creates finished spreadsheets and checks each number as it goes\"},{\"icon\":\"Checklist\",\"text\":\"Shows its sources and separates what's known from what's estimated\"}],\"bullets_style\":\"icons\",\"template_key\":\"spotlight-v2\"},\"placement_key\":\"spotlight\",\"template_key\":\"spotlight-v2\",\"enabled\":false,\"variant_key\":\"free\",\"exp_id\":\"c0ff47e15c15d984\",\"tier\":\"1\",\"config\":{\"platform\":{\"allowed_paths\":[\"/new\"],\"show_on_mobile_web\":null},\"bypass_global_rules\":false,\"bypass_all_rules\":false}},{\"id\":\"2a09ec77-ba45-4849-8f04-bd34b6a12897\",\"key\":\"claudeai-admin-claude-tag-setup-spotlight\",\"content\":null,\"placement_key\":\"spotlight\",\"template_key\":null,\"enabled\":true,\"variant_key\":null,\"exp_id\":\"\",\"tier\":\"1\",\"config\":{\"platform\":{\"allowed_paths\":null,\"show_on_mobile_web\":null},\"bypass_global_rules\":false,\"bypass_all_rules\":false}},{\"id\":\"b6f033ad-fe99-4165-8dc8-4109cfaa9c4d\",\"key\":\"fund-unlock-nudge\",\"content\":{\"body\":