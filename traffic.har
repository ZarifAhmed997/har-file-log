e-banner\":{\"enabled\":true,\"paths\":[\"/new\"]},\"home-nudge\":{\"enabled\":true,\"paths\":[\"/new\",\"/task/new\",\"/epitaxy/*\"]},\"sidebar-callout\":{\"enabled\":true,\"paths\":[\"/*\"]},\"sidebar-popover\":{\"enabled\":true,\"paths\":[\"/*\"]},\"sidebar-product-badge\":{\"enabled\":true,\"paths\":[\"/*\"]},\"sidebar-row\":{\"enabled\":true,\"paths\":[\"/*\"]},\"spotlight\":{\"enabled\":true,\"paths\":[\"/new\",\"/task/new\",\"/code\",\"/epitaxy\"]}}},\"3071164246\":{\"defaultValue\":false},\"3074905367\":{\"defaultValue\":false},\"3077572275\":{\"defaultValue\":false},\"3079489876\":{\"defaultValue\":true},\"3080999985\":{\"defaultValue\":true,\"rules\":[{\"force\":true,\"tracks\":[{\"experiment\":{\"hashAttribute\":\"organizationUUID\",\"key\":\"console_betony\",\"variations\":[false,true]},\"result\":{\"featureId\":\"3080999985\",\"hashAttribute\":\"organizationUUID\",\"hashUsed\":true,\"hashValue\":\"8a499207-0c8b-48c8-92d1-ecb2e37f516a\",\"inExperiment\":true,\"key\":\"1\",\"value\":true,\"variationId\":1}}]}]},\"3082880741\":{\"defaultValue\":false},\"3082987388\":{\"defaultValue\":false},\"3083259802\":{\"defaultValue\":{\"cyberModelFallbacks\":{\"claude-fable-5\":{\"displayName\":\"Opus 4.8\",\"fallbackModelName\":\"claude-opus-4-8\"},\"claude-fable-5-1\":{\"displayName\":\"Opus 4.8\",\"fallbackModelName\":\"claude-opus-4-8\"}},\"modelFallbacks\":{\"claude-fable-5\":{\"displayName\":\"Opus 4.8\",\"fallbackModelName\":\"claude-opus-4-8\"},\"claude-fable-5-1\":{\"displayName\":\"Opus 4.8\",\"fallbackModelName\":\"claude-opus-4-8\"},\"claude-opus-4-1-20250805\":{\"displayName\":\"Haiku 4.5\",\"fallbackModelName\":\"claude-haiku-4-5-20251001\"},\"claude-opus-4-20250514\":{\"displayName\":\"Haiku 4.5\",\"fallbackModelName\":\"claude-haiku-4-5-20251001\"},\"claude-opus-4-5-20251101\":{\"displayName\":\"Haiku 4.5\",\"fallbackModelName\":\"claude-haiku-4-5-20251001\"},\"claude-opus-4-6\":{\"displayName\":\"Sonnet 4.6\",\"fallbackModelName\":\"claude-sonnet-4-6\"},\"claude-opus-4-7\":{\"displayName\":\"Sonnet 4.6\",\"fallbackModelName\":\"claude-sonnet-4-6\"},\"claude-opus-4-8\":{\"displayName\":\"Sonnet 4.6\",\"fallbackModelName\":\"claude-sonnet-4-6\"},\"claude-sonnet-4-5-20250929\":{\"displayName\":\"Haiku 4.5\",\"fallbackModelName\":\"claude-haiku-4-5-20251001\"},\"claude-sonnet-4-6\":{\"displayName\":\"Haiku 4.5\",\"fallbackModelName\":\"claude-haiku-4-5-20251001\"},\"claude-sonnet-5\":{\"displayName\":\"Haiku 4.5\",\"fallbackModelName\":\"claude-haiku-4-5-20251001\"}}}},\"3084753453\":{\"defaultValue\":true},\"3085740797\":{\"defaultValue\":false},\"3089387226\":{\"defaultValue\":true},\"3095325678\":{\"defaultValue\":false},\"3103190307\":{\"defaultValue\":false},\"3103445538\":{\"defaultValue\":false},\"3105568308\":{\"defaultValue\":{\"value\":\"You are a text autocomplete system. Your job is to predict what the USER will type next in a chat interface.\\n\\nCRITICAL RULE: You are predicting the USER's words, NOT generating an assistant response. If your completion sounds like something an AI assistant would say, it is WRONG.\\n\\nGiven:\\n- A conversation history (may be empty for new chats)\\n- A partial message the user is currently typing\\n\\nOutput:\\n- The most likely continuation (1-5 words)\\n- Include a leading space if starting a new word\\n- No leading space if completing a partial word or adding punctuation\\n- Output NOTHING (empty <completion> tags) if you're not confident\\n\\n<examples>\\n<example>\\n<conversation>\\nUser: I'm thinking about going to the beach this weekend.\\nAssistant: That sounds fun! What beach are you considering?\\n</conversation>\\n<partial>What's the weather usually</partial>\\n<completion> like there?</completion>\\n<note>Space before \\\"like\\\" because \\\"usually\\\" is a complete word.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Can you help me with Python?\\nAssistant: Of course! What do you need help with?\\n</conversation>\\n<partial>I'm trying to underst</partial>\\n<completion>and how</completion>\\n<note>No space - continuing the word \\\"understand\\\".</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: What's the capital of France?\\nAssistant: The capital of France is Paris.\\n</conversation>\\n<partial>How many people live there</partial>\\n<completion>?</completion>\\n<note>No space before punctuation.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Tell me about machine learning.\\nAssistant: Machine learning is a branch of AI where systems learn from data.\\n</conversation>\\n<partial>Thanks</partial>\\n<completion>!</completion>\\n<note>User saying \\\"Thanks!\\\" - just punctuation.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: What's 2+2?\\nAssistant: 2+2 equals 4.\\n</conversation>\\n<partial>Thanks</partial>\\n<wrong> for explaining that!</wrong>\\n<why_wrong>This sounds like the user, but is too presumptuous about what they'll say.</why_wrong>\\n<completion>!</completion>\\n<note>When uncertain, complete minimally or not at all.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Hi!\\nAssistant: Hello! How can I help you today?\\n</conversation>\\n<partial>I want to</partial>\\n<completion></completion>\\n<note>Too ambiguous - could be anything. Output nothing.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Can you explain recursion?\\nAssistant: Recursion is when a function calls itself.\\n</conversation>\\n<partial>I see</partial>\\n<wrong>, that makes sense!</wrong>\\n<why_wrong>Presuming the user's reaction. They might disagree or have questions.</why_wrong>\\n<completion></completion>\\n<note>User's next thought is unpredictable here.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: What's the weather in Paris?\\nAssistant: It's currently 72°F and sunny in Paris.\\n</conversation>\\n<partial>What about in Lon</partial>\\n<completion>don?</completion>\\n<note>Completing \\\"London\\\" - obvious city name continuation.</note>\\n</example>\\n\\n<example>\\n<conversation></conversation>\\n<partial>How do I</partial>\\n<completion></completion>\\n<note>New chat with no context - too many possibilities. Output nothing.</note>\\n</example>\\n\\n<example>\\n<conversation></conversation>\\n<partial>What is the capital of Franc</partial>\\n<completion>e?</completion>\\n<note>Even without history, \\\"France\\\" is the obvious completion.</note>\\n</example>\\n\\n<example>\\n<conversation>\\nUser: Help me write an email.\\nAssistant: Sure! What's the email about?\\n</conversation>\\n<partial>It's for my b</partial>\\n<completion>oss</completion>\\n<note>Common word completion, but stop early - don't presume more.</note>\\n</example>\\n</examples>\\n\\nRULES:\\n1. You complete the USER's message, never generate an assistant response\\n2. Include the space in your output if needed (don't use Yes/No prefixes)\\n3. Output empty <completion></completion> if:\\n   - The partial could go many directions\\n   - You're less than ~80% confident\\n   - There's no conversation history AND the partial is ambiguous\\n4. Prefer shorter completions when uncertain\\n5. Common patterns to complete: finishing words, adding punctuation, obvious next words\\n6. Never complete with phrases like \\\"thank you for...\\\", \\\"I understand...\\\", \\\"that makes sense...\\\" - these assume user sentiment\\n\\n\"}},\"3105908926\":{\"defaultValue\":false},\"3108513975\":{\"defaultValue\":true},\"3109210260\":{\"defaultValue\":false},\"3110209724\":{\"defaultValue\":{\"allowed_models\":[\"claude-fable-5-1\",\"claude-opus-5\",\"claude-sonnet-5\",\"claude-haiku-4-5-20251001\"],\"legacy_models\":[\"claude-fable-5\",\"claude-opus-4-8\",\"claude-opus-4-7\",\"claude-opus-4-6\",\"claude-sonnet-4-6\"],\"model\":\"claude-sonnet-5\"},\"rules\":[{\"force\":{\"allowed_models\":[\"claude-fable-5-1\",\"claude-opus-5\",\"claude-sonnet-5\",\"claude-haiku-4-5-20251001\"],\"legacy_models\":[\"claude-fable-5\",\"claude-opus-4-8\",\"claude-opus-4-7\",\"claude-opus-4-6\",\"claude-sonnet-4-6\"],\"model\":\"claude-sonnet-5\"},\"id\":\"2154417815\"}]},\"3111467133\":{\"defaultValue\":true},\"3112015973\":{\"defaultValue\":false},\"3112807101\":{\"defaultValue\":false,\"rules\":[{\"force\":false,\"tracks\":[{\"experiment\":{\"hashAttribute\":\"organizationUUID\",\"key\":\"console_cicely\",\"variations\":[false,true]},\"result\":{\"featureId\":\"3112807101\",\"hashAttribute\":\"organizationUUID\",\"hashUsed\":true,\"hashValue\":\"8a499207-0c8b-48c8-92d1-ecb2e37f516a\",\"inExperiment\":true,\"key\":\"0\",\"value\":false,\"variationId\":0}}]}]},\"3114701586\":{\"defaultValue\":true},\"3115207192\":{\"defaultValue\":false},\"3115621409\":{\"defaultValue\":{\"variant\":\"step\"}},\"3115979251\":{\"defaultValue\":false},\"3121038202\":{\"defaultValue\":true},\"3121712118\":{\"defaultValue\":false},\"3122672740\":{\"defaultValue\":true},\"3122826305\":{\"defaultValue\":true},\"3123216116\":{\"defaultValue\":true},\"3123381885\":{\"defaultValue\":false},\"3125097832\":{\"defaultValue\":false},\"3125283277\":{\"defaultValue\":true},\"3126119686\":{\"defaultValue\":{}},\"3130929050\":{\"defaultValue\":false},\"3131174055\":{\"defaultValue\":false},\"3132343094\":{\"defaultValue\":false},\"3134022716\":{\"defaultValue\":false},\"3134199022\":{\"defaultValue\":true},\"3134359530\":{\"defaultValue\":false},\"3134659211\":{\"defaultValue\":{\"models\":[]}},\"3137137828\":{\"defaultValue\":true,\"rules\":[{\"force\":true,\"tracks\":[{\"experiment\":{\"hashAttribute\":\"organizationUUID\",\"key\":\"claudified_console_salsify\",\"variations\":[false,true]},\"result\":{\"featureId\":\"3137137828\",\"hashAttribute\":\"organizationUUID\",\"hashUsed\":true,\"hashValue\":\"8a499207-0c8b-48c8-92d1-ecb2e37f516a\",\"inExperiment\":true,\"key\":\"1\",\"value\":true,\"variationId\":1}}]}]},\"3140074548\":{\"defaultValue\":true},\"3142502564\":{\"defaultValue\":true},\"3142816791\":{\"defaultValue\":false},\"3143450433\":{\"defaultVal