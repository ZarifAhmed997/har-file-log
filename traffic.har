tNode) {\n              firstScript.parentNode.insertBefore(scriptTag, firstScript);\n            } else {\n              (document.head || document.documentElement).appendChild(\n                scriptTag,\n              );\n            }\n          };\n          window.ttq = ttq;\n          window.TiktokAnalyticsObject = \"ttq\";\n        }\n        function runTiktokPixelAdapter(envelope, entry) {\n          var tiktokMethod =\n            entry.vendor_event !== undefined &&\n            Object.prototype.hasOwnProperty.call(\n              TIKTOK_ALLOWED_VENDOR_EVENTS,\n              entry.vendor_event,\n            )\n              ? entry.vendor_event\n              : undefined;\n          if (tiktokMethod === undefined) {\n            logDebug(\"tiktok_pixel: no known vendor event on the entry, dropping\", {\n              event: envelope.event_name,\n            });\n            postAdapterCondition(\"adapter_event_unmapped\");\n            return;\n          }\n          var pixelIds = entry.pixel_ids;\n          if (!pixelIds || pixelIds.length === 0) {\n            logDebug(\n              \"tiktok_pixel: dormant (no pixel ids on the instruction)\",\n              { event: envelope.event_name },\n            );\n            postAdapterCondition(\"adapter_dormant\");\n            return;\n          }\n          for (var i = 0; i < pixelIds.length; i++) {\n            var pixelId = pixelIds[i];\n            if (!TIKTOK_PIXEL_ID_PATTERN.test(pixelId)) {\n              logDebug(\"tiktok_pixel: rejecting malformed pixel id\");\n              postAdapterCondition(\"adapter_bad_pixel_id\");\n              continue;\n            }\n            if (!loadedTiktokPixelIds[pixelId]) {\n              ensureTiktokBase();\n              // historyObserver off: TikTok's pixel measures a page view\n              // on its own whenever the URL changes in a single-page app\n              // by default, and documents this option as the opt-out\n              // (https://business-api.tiktok.com/portal/docs/work-with-single-page-applications/v1.3).\n              // This frame's URL never changes, so the observer would\n              // have nothing to see today; the option states the same\n              // rule Bing's enableAutoSpaTracking-off does - every fire\n              // is envelope-driven, no vendor self-firing.\n              window.ttq.load(pixelId, { historyObserver: false });\n              loadedTiktokPixelIds[pixelId] = true;\n            }\n            // instance(id) pins the call to that pixel, so a multi-id\n            // fan-out fires each exactly once. Every mapped event\n            // resolves to the page() method today; a future\n            // track-style mapping needs its own call shape here, not a\n            // reuse of this bare call.\n            window.ttq.instance(pixelId).page();\n            postPixelFireMetric(\n              envelope.event_name,\n              entry.destination,\n              pixelId,\n            );\n          }\n        }\n\n        // Microsoft Advertising UET command names by envelope event\n        // name. The UET base self-fires \"pageLoad\" on load in\n        // Microsoft's stock snippet; here the load is bare and every\n        // fire is an explicit envelope-driven push, and\n        // enableAutoSpaTracking stays off - a vendor self-firing on\n        // route changes would bypass the envelope-driven control, and\n        // page_viewed already fires per route change.\n        var BING_ALLOWED_VENDOR_EVENTS = {\n          pageLoad: true,\n        };\n        // The tag id is composed into the loader URL query; exact\n        // numeric guard before composing.\n        var BING_UET_ID_PATTERN = /^[0-9]{1,16}$/;\n        // One UET instance per configured tag id (per-id fan-out).\n        // Pre-load, an instance is a plain command-queue array; when\n        // bat.js arrives each is rebuilt as new UET({ti, q}), which\n        // drains it - the same handoff Microsoft's st